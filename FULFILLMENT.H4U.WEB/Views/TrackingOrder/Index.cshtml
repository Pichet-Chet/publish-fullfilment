    <script>
        disabledTimeline();

        $('#btn-search').click(function () {
            const input = $('#input').val();
            $('#trackingDisplay').slideUp();

            $.ajax({
                url: '@Url.Action("GET_ALL", "TrackingOrder")',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: { purchaseOrderNo: input },
                success: (res) => {

                    $('#timeline-icon-i-1').addClass('text-secondary');
                    $('#timeline-icon-i-2').addClass('text-secondary');
                    $('#timeline-icon-i-3').addClass('text-secondary');
                    $('#timeline-icon-i-4').addClass('text-secondary');

                    ////console.log('getItems', res);
                    if (res.message === 'DATA NOT FOUND.') {
                        disabledTimeline();
                        showAlertFail();
                    }
                    else {
                        let data = res.output_data;
                        $('#trackingDisplay').slideDown();
                        if (data.purchaseOrderDate) { setTimeline({ number: 1, dateTime: data.purchaseOrderDate, message: data.purchaseOrderNo }); }
                        if (data.picklistDate) { setTimeline({ number: 2, dateTime: data.picklistDate, message: data.picklistNo }); }
                        if (data.packingDate) { setTimeline({ number: 3, dateTime: data.packingDate, message: data.packingNo }); }
                        if (data.shippedDate) { setTimeline({ number: 4, dateTime: data.shippedDate, message: data.shippedTracking, trackingLink: data.shippedWebsite, trackingName: data.purchaseOrderShipping }); }
                    }
                },
                error: (res) => {
                    disabledTimeline();
                    showAlertFail();
                    ////console.log(res.statusText);
                },
            });
        });

        $('#trackingDisplay').hide();

        function setTimeline({ number, dateTime, message, trackingLink, trackingName }) {
            $('#trackingDisplay').slideDown();
            $('#timeline-icon-' + number).addClass('bg-orange');
            $('#timeline-icon-' + number).removeClass('bg-light');

            $('#timeline-label-' + number).addClass('bg-orange');
            $('#timeline-label-' + number).removeClass('bg-light');

            $('#timeline-title-' + number).removeClass('text-muted');
            $('#timeline-message-' + number).removeClass('text-muted');

            let date, time;
            if (dateTime) {
                date = moment(dateTime).format('DD/MM/YYYY')
                time = moment(dateTime).format('HH:mm')
            }

            $('#timeline-time-' + number).text(time + 'น.');
            $('#timeline-date-' + number).text(date);
            $('#timeline-icon-i-' + number).removeClass('text-secondary');

            if (number == 4) {
                $('#tracking-title').removeClass('text-muted');
                $('#tracking-link').attr('href', trackingLink);
                $('#tracking-badge').show();
                $('#tracking-link').show();
                $('#tracking-link').text(trackingName);
                $('#timeline-message-4').data('number', message);
            }

            if (number == 1) { message = `Purchase Order Number: ${message}`; }
            if (number == 2) { message = `Pick List Number: ${message}`; }
            if (number == 3) { message = `Packing Number: ${message}`; }
            if (number == 4) { message = `Tracking Number: ${message}`; }
            $('#timeline-message-' + number).text(message);


        }

        function disabledTimeline() {
            $('#trackingDisplay').slideUp();

            $('#tracking-link').attr('href', '#');
            $('#tracking-link').text('');
            $('#tracking-badge').hide();
            $('#tracking-link').hide();
            $('#tracking-title').addClass('text-muted');

            for (let number = 1; number <= 4; number++) {
                $('#timeline-icon-' + number).removeClass('bg-orange');
                $('#timeline-icon-' + number).addClass('bg-light');

                $('#timeline-label-' + number).removeClass('bg-orange');
                $('#timeline-label-' + number).addClass('bg-light');

                $('#timeline-title-' + number).addClass('text-muted');
                $('#timeline-message-' + number).addClass('text-muted');

                $('#timeline-time-' + number).text('');
                $('#timeline-date-' + number).text('');

                if (number == 1) { message = `Purchase Order Number:`; }
                if (number == 2) { message = `Pick List Number:`; }
                if (number == 3) { message = `Packing Number:`; }
                if (number == 4) { message = `Tracking Number:`; }
                $('#timeline-message-' + number).text(message);
            }
        }

        function showAlertFail() {
            let showBasicToast = new bootstrap.Toast($('.warning-toast'));
            $('.warning-toast-message').text('Tracking Number ไม่ถูกต้อง');
            showBasicToast.show();
        }

        function clipboard(el) {
            let value = $(el).children(1).data('number');
            ////console.log('copy text is ' + value);
            navigator.clipboard.writeText(value);
            toastAlert('success', 'Success', 'Copied: ' + value + '👋');
        }

        function toastAlert(type, title, message) {
            toastr[type](message, title, {
                closeButton: true,
                tapToDismiss: false,
                timeOut: 2000,
            });
        }

    </script>
