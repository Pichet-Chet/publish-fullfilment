@{
    Layout = "~/Views/Shared/Template/_MasterScript.cshtml";
}

<script>
    let model = {
        id: 0,
        name: "",
        size: "",
        description: "",
        isActive: false,
    }

    function getFormData() {

        let formData = new FormData(document.getElementById('form-create'));

        const data = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.id) { data.id = 0; }

        data.id = parseInt(data.id);
        data.isActive = Boolean(data.isActive);

        return data;
    }

    function disabledForm({ isEdit }) {
        if (isEdit) {
            document.getElementsByName('name')[0].disabled = false;
        }
        else {
            document.getElementsByName('name')[0].disabled = false;
        }
    }

    function setForm(data) {
        document.getElementsByName('id')[0].value = data.id;
        document.getElementsByName('name')[0].value = data.name;
        document.getElementsByName('name')[0].disabled = true;

        document.getElementsByName('size')[0].value = data.size;
        document.getElementsByName('description')[0].value = data.description;

        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);
    }

    let columnDefs = [

        {
            field: 'name',
            headerName: 'รหัสกล่อง (QR Code)',
            filter: 'agTextColumnFilter',
            minWidth: 200,
            cellRenderer: function({ value }) {
                return '<div> ' + value + ' <i class="fas fa-copy text-secondary" data-toggle="tooltip" data-placement="bottom" title="Copy" style="cursor: pointer;" onClick="clipboard(\'' + value + '\')"> ';
            }
        },
        {
            field: 'size',
            headerName: 'ขนาด',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'description',
            headerName: 'รายละเอียด',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'isActive',
            headerName: 'เปิด - ปิด',
            filter: 'agTextColumnFilter',
            minWidth: 200,
            cellRenderer: function({ value }) {
                if (value == true) {
                    return ' <span class="badge bg-warning w-50">ACTIVE</span>';
                }
                else {
                    return ' <span class="badge bg-secondary w-50">DISABLE</span>';
                }
            }
        },

        {
            field: 'action',
            headerName: '',
            cellStyle: { textAlign: 'center' },
            minWidth: 50,
            width: 50,
            pinned: 'right',
            cellRenderer: function (params) {
                return `
                    <div class="text-primary">
                        <i class="fas fa-print" data-toggle="tooltip" data-placement="bottom" title="ปริ้น" onClick="showBarcode('${params.data.name}')">
                        </div>`;
            }
        },

        {
            field: 'action',
            headerName: '#',
            cellStyle: { textAlign: 'center' },
            minWidth: 60,
            width: 60,
            pinned: 'right',
            cellRenderer: function({ data }) {
                return '<div><i class="fas fa-edit" data-toggle="tooltip" data-placement="bottom" title="แก้ไข" style="color:orange; cursor: pointer;" onClick="openEditModal(' + data.id + ')"> ';
            }
        }
    ];


</script>