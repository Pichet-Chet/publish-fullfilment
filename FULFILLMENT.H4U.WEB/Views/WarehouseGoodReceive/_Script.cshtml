    function grItemAddSheft(grItem, sheftId) {
        const data = {
            header: { id: 0, },
            item: [{ id: grItem.id, sheftId }]
        };

        $.ajax({
            type: "POST",
            url: '@Url.Action("UPDATE", "WarehouseGoodReceive")',
