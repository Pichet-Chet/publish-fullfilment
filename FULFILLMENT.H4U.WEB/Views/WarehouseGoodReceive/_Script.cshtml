    async function openCancelGrProductModal(id) {
        clearFormCreate();
        try {
            // get Inbound items
            const getIbProducts = await callApi({ type: "POST", url: '@Url.Action("GET_ITEM", "RequestInbound")?headerId=' + id });
            ////console.log('getIbProducts', getIbProducts);
            INBOUND_ITEMS = getIbProducts ? getIbProducts : [];

            // set form repeater
            const repeaterData = INBOUND_ITEMS.map((item) => {
                return {
                    'id': item.id,
                    'cancelHeaderId': item.headerId,
                    'cancelProductId': item.productId,
                    'cancelAmount': 0,
                    'cancelRemark': ''
                }
            });

            ////console.log('repeaterData', repeaterData);

            $repeaterCancel.setList(repeaterData);

            $('.cancelProductDisplay').each(function (i, obj) {
                $(this).val(repeaterData[i].cancelProductId);
                ////console.log('>>', repeaterData[i].cancelProductId);
            });
            setAmountProducts();
            // get Inbound detail
            const getIbDetail = await callApi({ type: "POST", url: '@Url.Action("DETAIL", "RequestInbound")?id=' + id });

            ////console.log('getIbDetail', getIbDetail);
            cancelGrSetForm(getIbDetail);
            modalGrCancel.show();
        } catch (e) {
            alertError(e.message);
        }
    }

