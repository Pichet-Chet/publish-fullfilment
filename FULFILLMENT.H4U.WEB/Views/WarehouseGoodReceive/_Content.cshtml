<div class="content-body">
    <section>
        <div class="row match-height">

            <div class="col-lg-12 col-12">
                <div class="card card-company-table">
                    <div class="card-header">
                        <div class="row">
                            <h3 class="float-start mb-0">รายการแจ้งสินค้าเข้าโกดัง</h3>
                        </div>

                        <div class="row">
                            <div class="col-12 col-sm-8 col-md-8 col-lg-9 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="inbound-basic-addon-search">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"> <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line> </svg>
                                    </span>
                                    <input id="inbound-filter-text-box" type="search" class="form-control" placeholder="ค้นหา . . . . . " aria-label="Search..." aria-describedby="basic-addon-search" oninput="onInboundFillterTable()">
                                </div>
                            </div>

                            <div class="col-12 col-sm-3 col-md-1 col-lg-1 p-1">
                                <div class="d-grid">
                                    <button type="button" class="btn btn-icon rounded-circle btn-flast-dark waves-effect float-end" onclick="getInbounds()">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-sm-3 col-md-3 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end" onclick="onInboundExportExcel()"> Export (.csv) </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="appTableInbound" style="height: 310px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12 col-12">
                <div class="card card-company-table">
                    <div class="card-header">

                        <div class="row">
                            <h3 class="float-start mb-0">รายการรับสินค้า</h3>
                        </div>

                        <div class="row">
                            <div class="col-12 col-sm-8 col-md-8 col-lg-9 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="inbound-basic-addon-search">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"> <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line> </svg>
                                    </span>
                                    <input id="gr-filter-text-box" type="search" class="form-control" placeholder="ค้นหา . . . . . " aria-label="Search..." aria-describedby="basic-addon-search" oninput="onGrFillterTable()">
                                </div>
                            </div>

                            <div class="col-12 col-sm-1 col-md-1 col-lg-1 p-1">
                                <div class="d-grid">
                                    <button type="button" class="btn btn-icon rounded-circle btn-flast-dark waves-effect float-end" onclick="getGrItems()">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-sm-3 col-md-3 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end" onclick="onGrExportExcel()"> Export (.csv) </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="appTableGr" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal to create GR Start-->
<div class="modal fade" id="new-gr-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered">
        <form class="add-new-gr modal-content pb-1" id="form-create" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-gr-title"></span> @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>

            <div class="modal-body flex-grow-1">
                <input type="hidden" name="id" />
                <input type="hidden" name="documentNo" />
                <input type="hidden" name="vendorId" />
                <input type="hidden" name="inboundHeaderId" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">เลขที่เอกสาร</label>
                            <input type="text" class="form-control" name="documentNoDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">บริษัท - คู่ค้า<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="vendorIdDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label">หมายเหตุ</label>
                            <input id="ib-remark" type="text" class="form-control" name="remark" />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <h5>รายละเอียด</h5>
                            <div class="row text-muted text-h6">
                                <div class="col">ชื่อสินค้า</div>
                                <div class="col-2 col-md-1 text-end">จำนวน</div>
                                <div class="col-2 col-md-1 text-end">ทำรายการไปแล้ว</div>
                                <div class="col-3">หมายเหตุ</div>
                            </div>
                            <div class="inbound-products"></div>
                        </div>
                    </div>
                </div>

                <hr />

                <!-- repeater -->
                <div class="repeater-create">
                    <div class="d-flex justify-content-between mb-1">
                        <h4>รายการรับสินค้า</h4>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary add-round add-stock"
                                    data-repeater-create>
                                <i class="fa fa-plus"></i> เพิ่มรายการ
                            </button>
                        </div>
                    </div>

                    <div id="form-create-gr-products">
                        <div class="row" data-repeater-list="rounds">
                            <div class="col-lg-12" data-repeater-item>

                                <div class="card mb-1">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-12 text-end lot-display">
                                                <input type="text" name="lot"
                                                       class="form-control-plaintext text-end text-muted">
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="row">
                                                    <div class="col-lg-6">
                                                        <label class="form-label">Bin</label>
                                                        <div class="input-group mb-1">
                                                            <input name="scanBin" type="text" class="form-control scan-bin"
                                                                placeholder="Scan Bin" aria-label="Scan Bin"
                                                                aria-describedby="button-scan" 
                                                                onkeypress="return (event.key!='Enter')">
                                                            <button class="btn btn-outline-primary" type="button">ค้นหา</button>
                                                            <button class="btn btn-outline-danger scan-bin-clear" type="button">ยกเลิก</button>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-6 pt-1">
                                                        <div class="pt-lg-1"></div>
                                                        <div class="h2 text-muted binDisplay text-center">ไม่ระบุ</div>
                                                    </div>
        
                                                    <input type="hidden" name="updateBinId" class="updateBinId">
                                                    <input type="hidden" name="binId" class="binId">
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="row">
                                                    <!-- <div class="col-lg-6">
                                                        <label class="form-label">Sheft</label>
                                                        <div class="input-group mb-1">
                                                            <input name="scanSheft" type="text" class="form-control scan-sheft"
                                                                placeholder="Scan Sheft" aria-label="Scan Sheft"
                                                                aria-describedby="button-scan" 
                                                                onkeypress="return (event.key!='Enter')">
                                                            <button class="btn btn-outline-danger scan-sheft-clear" type="button">Clear</button>
                                                        </div>
                                                    </div> -->

                                                    <!-- <div class="col-lg-6 pt-1">
                                                        <div class="pt-lg-1"></div>
                                                        <div class="h2 text-muted sheftDisplay text-center">ไม่ระบุ</div>
                                                    </div>
                                                    
                                                    <input type="hidden" name="updateSheftId" class="updateSheftId">
                                                    <input type="hidden" name="sheftId" class="sheftId"> -->
                                                </div>
                                            </div>
                                            
                                            <!--Products-->
                                            <div class="col-lg-12 form-create-products inner-repeater mt-1">
                                                <div data-repeater-list="products">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h5>สินค้า</h5>
                                                        <div>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-info add-stock-product"
                                                                    data-repeater-create>
                                                                <i class="fa fa-plus"></i> เพิ่มสินค้า
                                                            </button>
                                                            <!-- -->
                                                        </div>
                                                    </div>
                                                    <div data-repeater-item>
                                                        <!-- <div class="row mt-1">
                                                            <div class="col-lg-4">
                                                                <label class="form-label required">Name</label>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label required">Amount</label>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label required">Remark</label>
                                                            </div>
                                                        </div>   -->
                                                        <div class="row mt-1">

                                                            <input type="hidden" name="id" value="0" />
                                                            <!-- <input type="hidden" name="headerId" value=""/> -->
                                                            <hr>
                                                            <div class="col-lg-4">
                                                                <input type="hidden" name="updateProductId"
                                                                       class="updateProductId">
                                                                <label class="form-label required">รหัสสินค้า SKU</label>

                                                                <input type="text"
                                                                       class="form-control calulate-amount"
                                                                       onchange="calulateAmount()" name="productSku"
                                                                       placeholder="ระบุรหัสสินค้า SKU*"
                                                                       onkeypress="return (event.key!='Enter')" 
                                                                       required />

                                                                <select class="form-select vendor-products calulate-amount"
                                                                         name="productId"
                                                                       hidden>
                                                                    <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label required">จำนวน</label>
                                                                <input type="text" data-input="convert"
                                                                       class="form-control calulate-amount"
                                                                       onchange="calulateAmount()" name="amount" min="1"
                                                                       placeholder="Amount*"
                                                                       onkeypress="return onlyNumberKey(event)" required />
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label">หมายเหตุ</label>
                                                                <input type="text" class="form-control" name="remark"
                                                                       placeholder="Remark" />
                                                            </div>
                                                            <div class="col-lg-2">
                                                                <button type="button"
                                                                        class="btn btn-icon btn-flat-danger delete-product"
                                                                        data-repeater-delete>
                                                                    <i class="fa fa-trash"></i> ลบสินค้า
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!--Products-->
                                            <div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger mt-2 delete-round"
                                                        data-repeater-delete>
                                                    ลบรายการ
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div id="form-create-gr-items">
                        <div id="appTableGrItems" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>



                <div class="modal-footer">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-1 data-submit"
                                id="form-gr-btn-create">
                            Save
                        </button>
                        <!-- <button type="submit" class="btn btn-info me-1 data-submit" id="form-gr-btn-update">Update</button> -->
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- end Modal Create GR -->
<!-- start Modal Cancel Gr Product -->
<div class="modal fade" id="cancel-gr-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered">
        <form class="form-cancel-gr modal-content pb-1" id="form-cancel-gr" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title">Cancel @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>

            <div class="modal-body flex-grow-1">
                <input type="hidden" name="cancelId" />
                <input type="hidden" name="cancelDocumentNo" />
                <input type="hidden" name="cancelVendorId" />
                <input type="hidden" name="cancelInboundHeaderId" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">เลขที่เอกสาร</label>
                            <input type="text" class="form-control" name="cancelDocumentNoDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">บริษัท - คู่ค้า<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="cancelVendorIdDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label">หมายเหตุ</label>
                            <input type="text" class="form-control" name="cancelRemark" disabled />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <h5>รายละเอียด</h5>
                            <div class="row text-muted text-h6">
                                <div class="col">สินค้า</div>
                                <div class="col-2 col-md-1 text-end">จำนวน</div>
                                <div class="col-2 col-md-1 text-end">ทำรายการไปแล้ว</div>
                                <div class="col-3">หมายเหตุ</div>
                            </div>
                            <div class="inbound-products"></div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-1">
                    <h4>รายการสินค้า</h4>
                </div>

                <div>
                    <div class="repeater-cancel">
                        <div class="row" data-repeater-list="products">
                            <div class="col-lg-12" data-repeater-item>

                                <div class="row mt-1">
                                    <input type="hidden" name="id" value="0" />
                                    <input type="hidden" name="cancelHeaderId" value="" />
                                    <hr>
                                    <div class="col-lg-4">
                                        <input type="hidden" name="cancelProductId">
                                        <label class="form-label required">ชื่อสินค้า</label>
                                        <select class="form-select vendor-products calulate-amount cancelProductDisplay"
                                                onchange="calulateAmountCancel()" name="cancelProductDisplay" disabled>
                                            <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-3">
                                        <label class="form-label required">จำนวนที่ต้องการยกเลิก</label>
                                        <input type="text" data-input="convert" class="form-control calulate-amount"
                                               onchange="calulateAmountCancel()" name="cancelAmount" min="1" placeholder="Amount*"
                                               onkeypress="return onlyNumberKey(event)" required />
                                    </div>
                                    <div class="col-lg-3">
                                        <label class="form-label">หมายเหตุ (*** โปรดระบุ)</label>
                                        <input type="text" class="form-control" name="cancelRemark" placeholder="Remark" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <div class="modal-footer">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-1" id="form-gr-btn-create">บันทึก</button>
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- end Modal Cancel Gr Product -->

<!-- start Modal Scan Sheft -->
<div class="modal fade" id="scan-sheft-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <form class="form-scan-sheft modal-content pb-1" id="form-scan-sheft" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title">Scan Sheft for Bin:<span id="add-sheft-for-bin"></span></h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body flex-grow-1">

                <div class="row">
                    <div class="col-12">
                        <label class="form-label required">Sheft</label>
                        <div class="input-group mb-1">
                            <input type="text" id="add-sheft-scan-gr" class="form-control add-sheft"
                                placeholder="Scan Sheft" aria-label="Scan Sheft"
                                aria-describedby="button-scan" onkeypress="return (event.key!='Enter')" required>
                            <button class="btn btn-outline-primary" type="button">ค้นหา</button>
                            <button class="btn btn-outline-danger add-sheft-clear" type="button">ยกเลิก</button>
                        </div>
                    </div>
                    <div class="col-12 py-1">
                        <div class="pt-1"></div>
                        <div class="h2 text-muted addSheftDisplay text-center">ไม่ระบุ</div>
                        <input type="hidden" class="addSheftId">
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="form-group">
                        <button type="button" class="btn btn-primary me-1" id="add-sheft-submit">บันทึก</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- end Modal Scan Sheft -->

<!-- warning toast -->
<div class="toast warning-toast position-fixed top-0 end-0 text-white bg-warning border-0" style="z-index: 1500;" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
    <div class="d-flex">
      <div class="toast-body warning-toast-message">ข้อมูลที่ Scan ไม่ถูกต้อง</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
<!-- warning toast ends -->