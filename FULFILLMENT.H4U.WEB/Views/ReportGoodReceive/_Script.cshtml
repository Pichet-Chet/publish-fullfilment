    const productModel = {
        id: 0,
        headerId: 0,
        productId: 0,
        receiveStatus: "PENDING",
        amount: 0,
        locationId: 1,
        sheftId: 0,
        binId: 0,
        lot: "",
        seq: 0,
        remark: ""
    }

    function getProductData() {
        const data = $('.repeater-create').repeaterVal();

        let products = [];

        const rounds = data.rounds.forEach(round => {
            round.products.forEach(product => {
                product.amount = parseInt(product.amount);
                product.productId = parseInt(product.productId);
                products.push({
                    ...productModel,
                    ...product,
                    binId: parseInt(round.binId),
                    sheftId: parseInt(round.sheftId),
                    id: 0
                });
            })
        })

        //console.log('getProductData', products);
        return products;
    }

    function getFormData() {
        let data = {
            id: $("[name='id']").val(),
            documentNo: '',
            inboundHeaderId: parseInt($("[name='inboundHeaderId']").val()),
            vendorId: parseInt($("[name='vendorId']").val()),
            remark: $("[name='remark']").val(),
        };
        if (!data.id) { data.id = 0; }
        data.id = parseInt(data.id);
        return data;
    }

    function createGR() {
        $(':input[type="submit"]').prop('disabled', true);
        let dataForm = getFormData();
        let products = getProductData();

        const data = { header: dataForm, item: products };
        //console.log('data', data);

        $.ajax({
            type: "POST",
            url: '@Url.Action("INSERT", ViewData["ControllerName"])',
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function(res) {
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }
                getGrItems();
                getInbounds();
                $('#new-gr-modal').modal('hide');
                alertSuccess();
            },
            complete: () => { $(':input[type="submit"]').prop('disabled', false); }

        })

    }

