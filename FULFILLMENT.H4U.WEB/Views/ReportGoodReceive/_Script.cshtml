<script>
    //Master Data
    let PRODUCTS = [];
    let VENDORS = [];
    let BINS = [];
    let SHEFTS = [];
    let INBOUND_ITEMS = [];
    let GR_ITEMS = [];
    let SUM_AMOUNT = [];
    let VALIDATE_SUM_AMOUNT = false;
    let VALIDATE_PRODUCT_DUPLICATE = false;
    let IS_CREATE = true;

    getMaster();

    async function getMaster() {
        await getVendors();
        await getBins();
        await getShefts();
        await getProducts();
    }


    function getProducts() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterProduct")',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getProducts', res.output_data);
                PRODUCTS = res.output_data;
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function getVendors() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterVendor")',
            data: { isActive: true },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getVendors', res.output_data);
                VENDORS = res.output_data;
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function getBins() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterBin")',
            data: { isActive: true, binType: 'INVENTORY' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getBins', res.output_data);
                BINS = res.output_data;
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function getShefts() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterSheft")',
            data: { isActive: true },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getShefts', res.output_data);
                SHEFTS = res.output_data;
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function setDropdownBins() {
        $('.binId').each(function(i, obj) {
            const val = $(this).val();
            $(this).html(`<option value="">--- กรุณาเลือกข้อมูล ---</option>`);
            BINS.forEach((d) => {
                $(this).append(`<option value="${d.binId}">${d.binName}</option>`);
            })
            $(this).val(val);
        });
    }

    function setDropdownShefts() {
        $('.sheftId').each(function(i, obj) {
            const val = $(this).val();
            $(this).html(`<option value="">--- กรุณาเลือกข้อมูล ---</option>`);
            SHEFTS.forEach((d) => {
                $(this).append(`<option value="${d.sheftId}">${d.sheftName}</option>`);
            })
            $(this).val(val);
        });
    }

    function setDropdownVendorProducts() {
        const ib = INBOUND_ITEMS.map(i => i.productId);
        const data = PRODUCTS.filter(p => ib.includes(p.productId));

        $('.vendor-products').each(function(i, obj) {
            const val = $(this).val();

            $(this).html(`<option value="">--- กรุณาเลือกข้อมูล ---</option>`);

            data.forEach((d) => {
                $(this).append(`<option value="${d.productId}">${d.productName}</option>`);
            });

            $(this).val(val);

        });
    }

    function findVendor(id) {
        return VENDORS.find(x => x.id == id);
    }

    function findProduct(id) {
        return PRODUCTS.find(x => x.id == id);
    }

    function findBin(id) {
        return BINS.find(x => x.id == id);
    }

    function findSheft(id) {
        return SHEFTS.find(x => x.id == id);
    }

    function fillterProductByVendor(vendorId) {
        return PRODUCTS.filter(p => p.vendorId === vendorId);
    }

    var $repeater = null;

    function setDrowdownOnAddStockAndProduct() {
        setDropdownBins();
        setDropdownShefts();
        setDropdownVendorProducts();
    }

    $repeater = $('.repeater-create').repeater({
        show: function() {
            $(this).slideDown();
            setDrowdownOnAddStockAndProduct();
        },
        isFirstItemUndeletable: true,
        repeaters: [{
            show: function() {
                $(this).slideDown();
                setDrowdownOnAddStockAndProduct();
            },
            isFirstItemUndeletable: true,
            selector: '.inner-repeater'
        }]
    });

    function clearFormCreate() {

        SUM_AMOUNT = [];
        VALIDATE_SUM_AMOUNT = false;
        VALIDATE_PRODUCT_DUPLICATE = false;
        $('#form-create').removeClass('was-validated')
    }

    // on update product, amount
    function calulateAmount() {
        SUM_AMOUNT = [];
        VALIDATE_PRODUCT_DUPLICATE = false;
        const repeaterData = $('.repeater-create').repeaterVal();

        const rounds = repeaterData.rounds.forEach(round => {

            //console.log('round', round);

            let checkProductDuplicateInCard = [];

            round.products.forEach(repeaterProduct => {
                //console.log('repeaterProduct', repeaterProduct);

                const sumIndex = SUM_AMOUNT.findIndex(sumAmount => sumAmount.id == repeaterProduct.productId);

                //console.log(sumIndex, 'sumIndex');
                if (repeaterProduct.productId && repeaterProduct.amount) {

                    if (checkProductDuplicateInCard.includes(repeaterProduct.productId)) {
                        VALIDATE_PRODUCT_DUPLICATE = true;
                    }

                    checkProductDuplicateInCard.push(repeaterProduct.productId);

                    if (sumIndex == -1) {
                        SUM_AMOUNT.push({ id: parseInt(repeaterProduct.productId), amount: parseInt(repeaterProduct.amount) });
                    }
                    else {
                        SUM_AMOUNT[sumIndex].amount += parseInt(repeaterProduct.amount);
                    }
                }
            });
        });

        //console.log('SUM_AMOUNT_END', SUM_AMOUNT);

        setAmountProducts();
    }

    function calulateAmountCancel() {
        SUM_AMOUNT = [];
        VALIDATE_PRODUCT_DUPLICATE = false;
        const repeaterData = $('.repeater-cancel').repeaterVal();
        //console.log('cancel repeaterData', repeaterData);
        let checkProductDuplicateInCard = [];

        repeaterData.products.forEach(repeaterProduct => {
            //console.log('cancel repeaterProduct', repeaterProduct);
            const sumIndex = SUM_AMOUNT.findIndex(sumAmount => sumAmount.id == repeaterProduct.cancelProductId);

            //console.log(sumIndex, 'sumIndex');
            if (repeaterProduct.cancelProductId && repeaterProduct.cancelAmount) {

                if (checkProductDuplicateInCard.includes(repeaterProduct.cancelProductId)) {
                    VALIDATE_PRODUCT_DUPLICATE = true;
                }

                checkProductDuplicateInCard.push(repeaterProduct.cancelProductId);

                if (sumIndex == -1) {
                    SUM_AMOUNT.push({ id: parseInt(repeaterProduct.cancelProductId), amount: parseInt(repeaterProduct.cancelAmount) });
                }
                else {
                    SUM_AMOUNT[sumIndex].amount += parseInt(repeaterProduct.cancelAmount);
                }
            }
        });

        //console.log('SUM_AMOUNT_END', SUM_AMOUNT);

        setAmountProducts();
    }

    // on open create, update, on after input product, amount
    function setAmountProducts() {

        VALIDATE_SUM_AMOUNT = false;

        //console.log('INBOUND_ITEMS', INBOUND_ITEMS);

        let data = INBOUND_ITEMS.map(i => {
            return {
                id: i.productId,
                sku: i.productSku,
                name: i.productName,
                amount: i.amount,
                stock: 0,
                remark: i.remark,
                received: i.received,
            }
        });

        $('.inbound-products').html('');
        data.forEach((p) => {

            let sum = { id: p.id, amount: 0 };
            if (SUM_AMOUNT.find(x => x.id == p.id)) {
                sum = SUM_AMOUNT.find(x => x.id == p.id);
            }

            sum.amount = sum.amount ? sum.amount : 0;

            if (IS_CREATE) {
                sum.amount += parseInt(p.received ? p.received : 0);
            }

            $('.inbound-products')
                .append(`
                                                        <div         class="row">
                                                            <div         class="col-3">${p.sku} : ${p.name}</div>
                                                            <div         class="col-2 h4 text-end"><b> ${p.amount}</b></div>
                                                            <div         class="col-2 h4 text-end in-stock-${p.id}"><b>${sum ? sum.amount : '0'}</b></div>
                                                            <div         class="col-5">${p.remark}</div>
                                                        </di        v>`);

            const className = '.in-stock-' + p.id;
            $(className).removeClass('text-success text-danger');

            if (sum && sum.amount == p.amount) {
                //console.log('==')
                $(className).addClass('text-success');
            }
            else if (sum && sum.amount > p.amount) {
                //console.log('>')
                $(className).addClass('text-danger');
                VALIDATE_SUM_AMOUNT = true;
            }
        });
    }

    function setAmountProductsUpdate() {

        //console.log('INBOUND_ITEMS', INBOUND_ITEMS);
        //console.log('GR_ITEMS', GR_ITEMS);

        let data = INBOUND_ITEMS.map(i => {
            return {
                id: i.productId,
                sku: i.productSku,
                name: i.productName,
                amount: i.amount,
                stock: 0,
                remark: i.remark,
                received: i.received,
            }
        });

        $('.inbound-products').html('');
        data.forEach((p) => {
            let sum = { id: p.id, amount: 0 };
            if (SUM_AMOUNT.find(x => x.id == p.id)) {
                sum = SUM_AMOUNT.find(x => x.id == p.id);
            }
            sum.amount = sum.amount ? sum.amount : 0;
            sum.amount += parseInt(p.received ? p.received : 0);
            $('.inbound-products')
                .append(`
                                                            <div         class="row">
                                                                <div         class="col-3">${p.sku} : ${p.name}</div>
                                                                <div         class="col-2 h4 text-end"><b> ${p.amount}</b></div>
                                                                <div         class="col-2 h4 text-end in-stock-${p.id}"><b>${sum ? sum.amount : '0'}</b></div>
                                                                <div         class="col-5">${p.remark}</div>
                                                            </di        v>`);

        });
    }


</script>

