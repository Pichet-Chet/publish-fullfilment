<div class="content-body">
    <section>
        <div class="row match-height">
           
            <div class="col-lg-12 col-12">
                <div class="card card-company-table">
                    <div class="card-header">

                        <div class="row">
                            <h3 class="float-start mb-0"></h3>
                        </div>

                        <div class="row">
                            <div class="col-12 col-sm-8 col-md-8 col-lg-9 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="inbound-basic-addon-search">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"> <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line> </svg>
                                    </span>
                                    <input id="gr-filter-text-box" type="search" class="form-control" placeholder="ค้นหา . . . . . " aria-label="Search..." aria-describedby="basic-addon-search" oninput="onGrFillterTable()">
                                </div>
                            </div>

                            <div class="col-12 col-sm-1 col-md-1 col-lg-1 p-1">
                                <div class="d-grid">
                                    <button type="button" class="btn btn-icon rounded-circle btn-flast-dark waves-effect float-end" onclick="getGrItems()">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-sm-3 col-md-3 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end" onclick="onGrExportExcel()"> Export </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="appTableGr" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal to create GR Start-->
<div class="modal fade" id="new-gr-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered">
        <form class="add-new-gr modal-content pb-1" id="form-create" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-gr-title"></span> @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>

            <div class="modal-body flex-grow-1">
                <input type="hidden" name="id" />
                <input type="hidden" name="documentNo" />
                <input type="hidden" name="vendorId" />
                <input type="hidden" name="inboundHeaderId" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">DocumentNo</label>
                            <input type="text" class="form-control" name="documentNoDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">Vendor<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="vendorIdDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label">Remark</label>
                            <input id="ib-remark" type="text" class="form-control" name="remark" />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <h5>Products</h5>
                            <div class="row text-muted text-h6">
                                <div class="col-3">Name</div>
                                <div class="col-2 text-end">Amount</div>
                                <div class="col-2 text-end">Received</div>
                                <div class="col-5">Remark</div>
                            </div>
                            <div class="inbound-products"></div>
                        </div>
                    </div>
                </div>

                <hr />

                <!-- repeater -->
                <div class="repeater-create">
                    <div class="d-flex justify-content-between mb-1">
                        <h4>เอกสารใบรับของ</h4>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary add-round add-stock"
                                    data-repeater-create>
                                <i class="fa fa-plus"></i> Add
                            </button>
                        </div>
                    </div>

                    <div id="form-create-gr-products">
                        <div class="row" data-repeater-list="rounds">
                            <div class="col-lg-12" data-repeater-item>

                                <div class="card mb-1">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-12 text-end lot-display">
                                                <input type="text" name="lot"
                                                       class="form-control-plaintext text-end text-muted">
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="mb-1">
                                                    <input type="hidden" name="updateBinId" class="updateBinId">
                                                    <label class="form-label required">Bin</label>
                                                    <select class="form-select binId" name="binId" required>
                                                        <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="mb-1">
                                                    <input type="hidden" name="updateSheftId" class="updateSheftId">
                                                    <label class="form-label required">Sheft</label>
                                                    <select class="form-select sheftId" name="sheftId" required>
                                                        <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <!--Products-->
                                            <div class="col-lg-12 form-create-products inner-repeater mt-1">
                                                <div data-repeater-list="products">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h5>Products</h5>
                                                        <div>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-info add-stock-product"
                                                                    data-repeater-create>
                                                                <i class="fa fa-plus"></i> Product
                                                            </button>
                                                            <!-- -->
                                                        </div>
                                                    </div>
                                                    <div data-repeater-item>
                                                        <!-- <div class="row mt-1">
                                                            <div class="col-lg-4">
                                                                <label class="form-label required">Name</label>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label required">Amount</label>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label required">Remark</label>
                                                            </div>
                                                        </div>   -->
                                                        <div class="row mt-1">

                                                            <input type="hidden" name="id" value="0" />
                                                            <!-- <input type="hidden" name="headerId" value=""/> -->
                                                            <hr>
                                                            <div class="col-lg-4">
                                                                <input type="hidden" name="updateProductId"
                                                                       class="updateProductId">
                                                                <label class="form-label required">Name</label>
                                                                <select class="form-select vendor-products calulate-amount"
                                                                        onchange="calulateAmount()" name="productId"
                                                                        required>
                                                                    <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label required">Amount</label>
                                                                <input type="text" data-input="convert"
                                                                       class="form-control calulate-amount"
                                                                       onchange="calulateAmount()" name="amount" min="1"
                                                                       placeholder="Amount*"
                                                                       onkeypress="return onlyNumberKey(event)" required />
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label">Remark</label>
                                                                <input type="text" class="form-control" name="remark"
                                                                       placeholder="Remark" />
                                                            </div>
                                                            <div class="col-lg-2">
                                                                <button type="button"
                                                                        class="btn btn-icon btn-flat-danger delete-product"
                                                                        data-repeater-delete>
                                                                    <i class="fa fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!--Products-->
                                            <div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger mt-2 delete-round"
                                                        data-repeater-delete>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div id="form-create-gr-items">
                        <div id="appTableGrItems" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>



                <div class="modal-footer">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-1 data-submit"
                                id="form-gr-btn-create">
                            Save
                        </button>
                        <!-- <button type="submit" class="btn btn-info me-1 data-submit" id="form-gr-btn-update">Update</button> -->
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- end Modal Create GR -->
