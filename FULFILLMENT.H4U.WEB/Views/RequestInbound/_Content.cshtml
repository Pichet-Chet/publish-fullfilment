<!-- Modal to add new item Start-->
<div class="modal fade" id="new-item-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered">
        <form class="add-new-item modal-content pb-1" id="form-create" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-create-title"></span> @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body flex-grow-1">

                <!-- Input Start-->
                <input type="hidden" class="form-control" name="id" />

                <div class="row">
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label required">ช่องทางการจัดส่ง</label>
                            <select id="shippingValue" class="form-select shippingValue" name="shippingValue" onchange="changeLbText()" required>
                                <option value="">--- กรุณาเลือกข้อมูล ---</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label required">วันที่จัดส่ง</label>
                            <input type="date" id="shippingDate" class="form-control" name="shippingDate" maxlength="50" required />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label required" id="lbInboundInformation">ทะเบียนรถ / Tracking no.</label>
                            <input type="text" id="carNumber" class="form-control" name="carNumber" maxlength="50" required disabled />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label">หมายเหตุ</label>
                            <input type="text" id="remark" class="form-control" name="remark" maxlength="250" />
                        </div>
                    </div>
                </div>
                <!-- Input End-->

                <div class="form-update">
                    <div id="badge-status"></div>
                </div>

                <hr />

                <div class="text-h5 mb-2">รายการสินค้า</div>

                <div class="row">
                    <div class="col-5">
                        <label class="form-label required">ชื่อสินค้า</label>
                    </div>
                    <div class="col-2">
                        <label class="form-label required">จำนวน</label>
                    </div>
                    <div class="col-3">
                        <label class="form-label">หมายเหตุ</label>
                    </div>
                </div>

                <div class="form-create repeater mb-2">
                    <div data-repeater-list="item">
                        <div class="row" data-repeater-item>
                            <div class="col-5">
                                <div class="mb-1">
                                    <select class="form-select productIds" name="productId" required>
                                        <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="mb-1">
                                    <input type="text" class="form-control" onkeypress="return onlyNumberKey(event)" name="amount" min="1" required />
                                    <input type="hidden" name="id" value="0" />

                                </div>
                            </div>
                            <div class="col-3">
                                <div class="mb-1">
                                    <input type="text" class="form-control" name="remark" maxlength="50" />
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="mb-1">
                                    <button class="btn btn-outline-danger" data-repeater-delete type="button">ลบ</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button id="add-product" class="btn btn-outline-warning" data-repeater-create type="button">เพิ่ม</button>
                </div>

                <div class="form-update form-update-products mb-2"></div>

                <div id="alert-product" class="alert alert-danger mb-2 alert-validation-msg" role="alert">
                    <div class="alert-body d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-info me-50"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        <span>Do not choose the same type of product.</span>
                    </div>
                </div>

                <ul id="form-create-by" class="list-unstyled fs-6 text-secondary d-none">
                    <li>
                        <span class="me-25">วันที่แก้ไข</span>
                        <span id="form-create-update-by"></span> <span id="form-create-update-date"></span>
                    </li>
                    <li>
                        <span class="me-25">Created By:</span>
                        <span id="form-create-create-by"></span> <span id="form-create-create-date"></span>
                    </li>
                </ul>

                <div class="modal-footer">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-1 data-submit" id="submit-add">บันทึก</button>
                        <button type="submit" class="btn btn-danger me-1 data-submit" id="submit-update">ยกเลิกรายการ</button>
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- Modal to add new item End-->