@{
    Layout = "~/Views/Shared/Template/_MasterScript.cshtml";
}

<script>
    let model = {
        vendorId: 0,
        //prefixName: null,
        vendorCode: null,
        vendorName: null,
        taxId: null,
        contactName: null,
        contactTel: null,
        contactAddress: null,
        lineId: null,
        email: null,
        website: null,
        serectKey: null,
        isActive: false,
    }

    function getFormData() {

        let formData = new FormData(document.getElementById('form-create'));

        const data = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.vendorId) { data.vendorId = 0; }

        data.vendorId = parseInt(data.vendorId);
        data.isActive = Boolean(data.isActive);

        return data;
    }

    function disabledForm({ isEdit }) {
        if (isEdit) {
            document.getElementsByName('vendorCode')[0].disabled = true;
            document.getElementsByName('taxId')[0].disabled = true;
            document.getElementsByName('email')[0].disabled = true;
        }
        else {
            document.getElementsByName('vendorCode')[0].disabled = false;
            document.getElementsByName('taxId')[0].disabled = false;
            document.getElementsByName('email')[0].disabled = false;
        }
    }

    function setForm(data) {
        document.getElementsByName('vendorId')[0].value = data.vendorId;
        //document.getElementsByName('prefixName')[0].value = data.prefixName;
        document.getElementsByName('vendorCode')[0].value = data.vendorCode;
        document.getElementsByName('vendorName')[0].value = data.vendorName;
        document.getElementsByName('taxId')[0].value = data.taxId;
        document.getElementsByName('contactName')[0].value = data.contactName;
        document.getElementsByName('contactTel')[0].value = data.contactTel;
        document.getElementsByName('contactAddress')[0].value = data.contactAddress;
        document.getElementsByName('lineId')[0].value = data.lineId;
        document.getElementsByName('email')[0].value = data.email;
        document.getElementsByName('website')[0].value = data.website;
        document.getElementsByName('serectKey')[0].value = data.serectKey;

        document.getElementsByName('isActive')[0].checked = data.isActive;

        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);
    }

    let columnDefs = [
        {
            field: 'taxId',
            headerName: 'เลขที่ผู้เสียภาษี',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'vendorCode',
            headerName: 'รหัสบริษัท - คู่ค้า',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'vendorName',
            headerName: 'ชื่อบริษัท - คู่ค้า',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'contactName',
            headerName: 'ชื่อผู้ติดต่อ',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'contactTel',
            headerName: 'เบอร์โทรติดต่อ',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'isActive',
            headerName: 'เปิด - ปิด',
            filter: 'agTextColumnFilter',
            minWidth: 200,
            cellRenderer: function({ value }) {
                if (value == true) {
                    return ' <span class="badge bg-warning w-50">ACTIVE</span>';
                }
                else {
                    return ' <span class="badge bg-secondary w-50">DISABLE</span>';
                }
            }
        },
        {
            field: 'action',
            headerName: '#',
            cellStyle: { textAlign: 'center' },
            minWidth: 60,
            width: 60,
            pinned: 'right',
            cellRenderer: function(params) {
                return '<div><i class="fas fa-edit" data-toggle="tooltip" data-placement="bottom" title="แก้ไข" style="color:orange; cursor: pointer;" onClick="openEditModal(' + params.data.vendorId + ')"> ';
            }
        }


        //{
        //    field: 'action',
        //    minWidth: 100,
        //    pinned: 'right',
        //    cellClass: "text-center",
        //    cellRenderer: (params) => {
        //        return `
        //                <button type="button" class="btn btn-flat-info" title="edit" onClick="openEditModal(${params.data.vendorId})">
        //                <i class="fa fa-pen"></i>
        //                </button>
        //            `
        //    }
        //}
    ];

    function genKey() {
        let uuid = self.crypto.randomUUID();
        let serectKey = uuid;
        $('[name="serectKey"]').val(serectKey);
    }

</script>