    function clearForm() {
        $('#form-create').removeClass('was-validated')
        document.getElementsByName('id')[0].value = "";
        document.getElementById("form-create").reset();
        $repeater.setList([
            {
                'productId': null,
                'amount': null,
                'remark': '',
            },
        ]);
    }


    function openFormModal({ isEdit }) {
        SUBMIT_CANCEL = isEdit;

        //console.log(SUBMIT_CANCEL);

        if (isEdit) {
            $('#form-create-title').text('แก้ไข ');
            $('#form-create-by').show()
            $('#submit-add').hide()
        }
        else {
            $('#form-create-title').text('เพิ่ม ');
            $('#form-create-by').hide()
            $('#submit-update').hide()
            $('#submit-add').show()
        }

        var modalCreate = new bootstrap.Modal(document.getElementById('new-item-modal'), {
            keyboard: false
        })
        modalCreate.show();
    }

    const gridOptions = {
        pagination: true,
        paginationPageSize: 20,
        paginationAutoPageSize: true,
