<div class="content-body">
    <section id="dashboard-ecommerce">
        <div class="row match-height">
            <div class="col-lg-12 col-12">
                <div class="card card-company-table">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-7 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon-search"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
                                    <input id="filter-text-box" type="search" class="form-control" placeholder="ค้นหา . . . . . " aria-label="Search..." aria-describedby="basic-addon-search" oninput="onFillterTable()">
                                </div>
                            </div>
                          
                            <div class="col-12 col-sm-4 col-md-4 col-lg-1 p-1">
                                <div class="d-grid">
                                    <button type="button" class="btn btn-icon rounded-circle btn-flast-dark waves-effect float-end" onclick="getItems()">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4 col-md-4 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-primary float-end" id="open-create-modal" onclick="openCreateModal()">เพิ่มรายการ @ViewData["Name"]</button>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4 col-md-4 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end" onclick="onExportExcel()">Export (.csv)</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="appTable" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>

                    <div class="card-body">

                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-7 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon-search"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
                                    <input id="filter-text-box-success" type="search" class="form-control" placeholder="ค้นหา . . . . . " aria-label="Search..." aria-describedby="basic-addon-search" oninput="onFillterTableSuccess()">
                                </div>
                            </div>
                            <div class="col-12 col-sm-4 col-md-4 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end" onclick="onExportExcelSuccess()">Export (.csv)</button>
                                </div>
                            </div>
                        </div>

                        <div id="appTableSuccess" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal to add new item Start-->
<div class="modal fade" id="new-item-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered">
        <form class="add-new-item modal-content pb-1" id="form-create" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-create-title"></span> @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body flex-grow-1">

                <!-- Input Start-->
                <input type="hidden" class="form-control" name="id" />
                <input type="hidden" class="form-control" name="headerId" />


                <div class="row">

                    <div class="col-lg-6">

                        <h3> รายละเอียดผู้ส่ง </h3>

                        <hr />

                        <div class="row">

                            <div class="col-lg-12">

                                <div class="mb-1">
                                    <label class="form-label required">ชื่อ - นามสกุล ผู้ส่ง <span> ( <input type="checkbox" id="checkboxFlagAdress" /> ใช้ที่อยู่เดียวกับ Profile ) </span></label>
                                    <input type="hidden" name="displayFromName" />
                                    <input type="text" class="form-control" name="fromName" maxlength="500" required />
                                </div>

                            </div>

                            <div class="col-lg-12">
                                <div class="mb-1">
                                    <label class="form-label required">ที่อยู่ผู้ส่ง</label>
                                    <input type="hidden" name="displayAddress" />
                                    <input type="text" class="form-control" name="fromAddress" maxlength="500" required />
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="mb-1">
                                    <label class="form-label required">เบอร์โทรผู้ส่ง</label>
                                    <input type="hidden" name="displayFromTel" />
                                    <input type="text" class="form-control" name="fromTel" onkeypress="return onlyNumberKey(event)" maxlength="10" required />
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="mb-1">
                                    <label class="form-label">อีเมลผู้ส่ง</label>
                                    <input type="hidden" name="displayFromEmail" />
                                    <input type="email" class="form-control" name="fromEmail" maxlength="300" />
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h3> รายละเอียดผู้รับ </h3>

                        <hr />

                        <div class="row">

                            <div class="col-lg-12">

                                <div class="mb-1">
                                    <label class="form-label required">ชื่อ - นามสกุล ผู้รับ</label>
                                    <input type="text" class="form-control" name="toName" maxlength="500" required />
                                </div>

                            </div>

                            <div class="col-lg-12">
                                <div class="mb-1">
                                    <label class="form-label required">ที่อยู่ผู้รับ</label>
                                    <input type="text" class="form-control" name="toAddress" maxlength="500" required />
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="mb-1">
                                    <label class="form-label required">เบอร์โทรผู้รับ</label>
                                    <input type="text" class="form-control" name="toTel" onkeypress="return onlyNumberKey(event)" maxlength="10" required />
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="mb-1">
                                    <label class="form-label">อีเมลผู้รับ</label>
                                    <input type="email" class="form-control" name="toEmail" maxlength="300" />
                                </div>
                            </div>

                        </div>
                    </div>


                </div>

                <hr />

                <div class="row">
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label">หมายเหตุ</label>
                            <input type="text" class="form-control" name="remark" multiple height="100" maxlength="250" />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">เลือกช่องทางการขาย</label>
                            <select class="form-select platformValue" name="platformValue">
                                <option value="">--- กรุณาเลือกข้อมูล ---</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">เลือกบริษัทขนส่ง</label>
                            <select class="form-select shippingValue" name="shippingValue" required>
                                <option value="">--- กรุณาเลือกข้อมูล ---</option>
                            </select>
                        </div>
                    </div>
                </div>
                <!-- Input End-->

                <div class="form-update">
                    <div id="badge-status"></div>
                </div>

                <hr />

                <div class="text-h5 mb-2">รายการสินค้า</div>

                <div id="areaProductRepeater">
                    <div class="row">
                        <div class="col-4">
                            <label class="form-label required">ชื่อสินค้า</label>
                        </div>
                        <div class="col-2">
                            <label class="form-label required">จำนวน</label>
                        </div>
                        <div class="col-2">
                            <label class="form-label">สต็อค</label>
                        </div>
                        <div class="col-3">
                            <label class="form-label">หมายเหตุ</label>
                        </div>
                    </div>

                    <div class="form-create repeater mb-2">
                        <div data-repeater-list="item">
                            <div class="row" data-repeater-item>
                                <div class="col-4">
                                    <div class="mb-1">
                                        <select class="form-select productIds" data-input="stock_1" name="productId" id="productId" onchange="getDataBalanceStock(this)" required>
                                            <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <div class="mb-1">
                                        <input type="text" class="form-control" onkeypress="return onlyNumberKey(event)" name="amount" min="1" required />
                                        <input type="hidden" name="id" value="0" />
                                    </div>
                                </div>
                                <div class="col-2">
                                    <div class="mb-1">
                                        <input type="text" class="form-control stock_1" onkeypress="return onlyNumberKey(event)" name="stockbalance" min="1" max="2" required disabled />
                                    </div>
                                </div>
                                <div class="col-2">
                                    <div class="mb-1">
                                        <input type="text" class="form-control" name="remark" maxlength="50" />
                                    </div>
                                </div>
                                <div class="col-2">
                                    <div class="mb-1">
                                        <button class="btn btn-outline-danger" data-repeater-delete type="button"><i class="fa fa-trash"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button id="add-product" class="btn btn-outline-warning" data-repeater-create type="button">เพิ่ม</button>
                    </div>
                </div>



                <div class="form-update form-update-products mb-2"></div>

                <ul id="form-create-by" class="list-unstyled fs-6 text-secondary d-none">
                    <li>
                        <span class="me-25">วันที่แก้ไข</span>
                        <span id="form-create-update-by"></span> <span id="form-create-update-date"></span>
                    </li>
                    <li>
                        <span class="me-25">Created By:</span>
                        <span id="form-create-create-by"></span> <span id="form-create-create-date"></span>
                    </li>
                </ul>

                <div class="modal-footer">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-1 data-submit" id="submit-add">บันทึก</button>
                        <button type="submit" class="btn btn-danger me-1 data-submit" id="submit-update">ยกเลิกรายการ</button>
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- Modal to add new item End-->