@using FULFILLMENT_H4U.Helper
@using FULFILLMENT.H4U.API.Model.Custom;

@{
    ViewSysUserModel userInfo = SessionHelper.GetObjectFromJson<ViewSysUserModel>(Context.Session, "UserInfo");
}

<!-- BEGIN: Header-->
<nav class="header-navbar navbar navbar-expand-lg align-items-center floating-nav navbar-light navbar-shadow container-xxl">
    <div class="navbar-container d-flex content">
        <div class="bookmark-wrapper d-flex align-items-center">
            <ul class="nav navbar-nav d-xl-none">
                <li class="nav-item"><a class="nav-link menu-toggle" href="#"><i class="ficon" data-feather="menu"></i></a></li>
            </ul>
            <ul class="nav navbar-nav">
                @*<li class="nav-item d-none d-lg-block"><a class="nav-link nav-link-style"><i class="ficon" data-feather="sun"></i></a></li>*@
            </ul>
        </div>
        <ul class="nav navbar-nav align-items-center ms-auto">
            <li class="nav-item dropdown dropdown-user">
                <a class="nav-link dropdown-toggle dropdown-user-link" id="dropdown-user" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <div class="user-nav d-sm-flex d-none">
                        <span class="user-name fw-bolder">@userInfo.FirstNameEn @userInfo.LastNameEn</span>
                        <span class="user-status">@userInfo.Email</span>
                        <input id="user-info-vendor-id" type="hidden" value='@userInfo.VenderId' />
                        <input id="user-info-role-name" type="hidden" value='@userInfo.Role' />
                    </div>
                    <div class="avatar bg-light-warning" height="40" width="40">
                        <div class="avatar-content">@userInfo.FirstNameEn.Substring(0, 1).ToUpper().ToString()@userInfo.LastNameEn.Substring(0, 1).ToUpper().ToString()</div>
                        <span class="avatar-status-online"></span>
                    </div>

                </a>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdown-user">
                    <a class="dropdown-item" onclick="fnEditProfile('@userInfo.UserId');">
                        <i class="me-50 fa fa-user"></i> แก้ไขบัญชีผู้งาน
                    </a>
                    <a class="dropdown-item" href="#">
                        <i class="me-50 fa fa-wallet"></i> @String.Format("{0:N2}", userInfo.vendorBalance) บาท
                    </a>
                    @*<a class="dropdown-item" href="#">
                            <i class="me-50" data-feather="user"></i> Profile
                        </a>*@
                    @*<a class="dropdown-item" href="#">
                            <i class="me-50" data-feather="help-circle"></i> FAQ
                        </a>*@
                    <a class="dropdown-item" href="@Url.Action("SignOut","Authentication")">
                        <i class="me-50" data-feather="power"></i> ออกจากระบบ
                    </a>
                </div>
            </li>
        </ul>
    </div>
</nav>
<!-- END: Header-->
<!-- Modal to add new item Start-->
<div class="modal fade" id="editProfile" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered">
        <div class="add-new-item modal-content pb-1" novalidate>

            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-create-title"></span> แก้ไขข้อมูลบัญชีผู้ใช้</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body flex-grow-1">

                <!-- Input Start-->
                <input type="hidden" class="form-control" name="userId" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">บัญชีผู้ใช้</label>
                            <input type="text" class="form-control" name="userName" minlength="5" maxlength="25" required />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">รหัสผ่าน</label>
                            <div class="input-group input-group-merge form-password-toggle">
                                <input type="password" class="form-control" name="userPassword" minlength="6" maxlength="50" required />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">ชื่อ (TH)</label>
                            <input type="text" class="form-control" name="firstNameTh" minlength="2" maxlength="50" required />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">นามสกุลe (TH)</label>
                            <input type="text" class="form-control" name="lastNameTh" minlength="2" maxlength="50" required />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">ชื่อ (EN)</label>
                            <input type="text" class="form-control" name="firstNameEn" minlength="2" maxlength="50" required />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">นามสกุล (EN)</label>
                            <input type="text" class="form-control" name="lastNameEn" minlength="2" maxlength="50" required />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">เบอร์โทร</label>
                            <input type="text" class="form-control" name="mobile" maxlength="10" onkeypress="return onlyNumberKey(event)" required />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">อีเมล</label>
                            <input disabled type="email" class="form-control" name="email" minlength="5" maxlength="50" required />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <label class="form-label required">รหัสบริษัท - คู่ค้า</label>
                            <input disabled type="text" class="form-control" name="secretKey" required />
                        </div>
                    </div>
                </div>


                <ul id="form-create-by" class="list-unstyled fs-6 text-secondary">
                    <li>
                        <span class="me-25">วันที่แก้ไข : </span>
                        <span id="form-create-update-by"></span> <span id="form-create-update-date"></span>
                    </li>
                    <li>
                        <span class="me-25">วันที่ทำรายการ : </span>
                        <span id="form-create-create-by"></span> <span id="form-create-create-date"></span>
                    </li>
                </ul>

                <div class="modal-footer">
                    <div class="form-group">
                        <a class="btn btn-primary me-1 data-submit" onclick="onSaveProfile();">บันทึก</a>
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
<!-- Modal to add new item End-->


<script type="text/javascript">


    function fnEditProfile(userId) {

        console.log(userId);

        $.ajax({
            type: "GET",
            url: '@Url.Action("DETAIL", "ManagementUser")?id=' + userId,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {

                console.log(res);
                setForm(res);

                $('#editProfile').modal('show');

            },
            error: (res) => {
                alertError(res.message);
            },
        });
    }

    function setForm(data) {

        document.getElementsByName('userId')[0].value = data.userId;
        document.getElementsByName('userName')[0].value = data.userName;
        document.getElementsByName('userPassword')[0].value = data.userPassword;
        document.getElementsByName('firstNameTh')[0].value = data.firstNameTh;
        document.getElementsByName('lastNameTh')[0].value = data.lastNameTh;
        document.getElementsByName('firstNameEn')[0].value = data.firstNameEn;
        document.getElementsByName('lastNameEn')[0].value = data.lastNameEn;
        document.getElementsByName('mobile')[0].value = data.mobile;
        document.getElementsByName('email')[0].value = data.email;
        document.getElementsByName('secretKey')[0].value = data.secretKey;


        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);

        $('[name="userName"]').attr("disabled", true);
    }

    function onSaveProfile() {

        var setProfileUserId = document.getElementsByName('userId')[0].value;
        var setProfilePassword = document.getElementsByName('userPassword')[0].value;
        var setProfileNameTh = document.getElementsByName('firstNameTh')[0].value;
        var setProfileLastNameTh = document.getElementsByName('lastNameTh')[0].value;
        var setProfileNameEn = document.getElementsByName('firstNameEn')[0].value;
        var setProfileLastNameEn = document.getElementsByName('lastNameEn')[0].value;
        var setProfileTel = document.getElementsByName('mobile')[0].value;

        //console.log(setProfilePassword);
        //console.log(setProfileNameTh);
        //console.log(setProfileLastNameTh);
        //console.log(setProfileNameEn);
        //console.log(setProfileLastNameEn);
        //console.log(setProfileTel);

        if (setProfilePassword != "" &&
            setProfileNameTh != "" &&
            setProfileLastNameTh != "" &&
            setProfileNameEn != "" &&
            setProfileLastNameEn != "" &&
            setProfileTel != "") {

            var model = getModel();

            $.ajax({
                type: "POST",
                url: '@Url.Action("EDIT_PROFILE", "ManagementUser")',
                data: JSON.stringify(model),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res) {

                    if (res.status === false) {
                        alertError(res.message);
                        return;
                    }

                    alertSuccess();
                },
                error: (res) => {
                    alertError(res.message);
                },
                complete: () => {

                }
            });
        }
        else {
            alertError("กรุณาตรวจสอบข้อมูลให้ครบถ้วนก่อนทำรายการอีกครั้ง");
        }


    }

    function getModel() {

        var model = new Object();

        model.userId = document.getElementsByName('userId')[0].value;
        model.userName = document.getElementsByName('userName')[0].value;
        model.userPassword = document.getElementsByName('userPassword')[0].value;
        model.firstNameTh = document.getElementsByName('firstNameTh')[0].value;
        model.lastNameTh = document.getElementsByName('lastNameTh')[0].value;
        model.firstNameEn = document.getElementsByName('firstNameEn')[0].value;
        model.lastNameEn = document.getElementsByName('lastNameEn')[0].value;
        model.mobile = document.getElementsByName('mobile')[0].value;
        model.email = document.getElementsByName('email')[0].value;
        model.secretKey = document.getElementsByName('secretKey')[0].value;

        return model;

    }

</script>