@RenderBody()

<script>
    $(document).ready(function () {
        var gridDiv = document.querySelector('#appTable');
        new agGrid.Grid(gridDiv, gridOptions);
        gridOptions.api.sizeColumnsToFit();

        getItems();
    });

    //addEventListener("load", (event) => { });

    //onload = (event) => { 
    //    getItems();
    //};

    // GET
    function getItems() {
        $.ajax({
            url: '@Url.Action("GET_ALL", ViewData["ControllerName"])',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                console.log('getItems', res);
                var outputData = res.output_data;
                gridOptions.api.setRowData(outputData);
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function onFillterTable() {
        gridOptions.api.setQuickFilter(
            document.getElementById('filter-text-box').value
        );
    }

    // CREATE
    let submitIsEdit = false;

    $(function () {
        $("#form-create").on("submit", function (e) {
            var form = $(this)[0];
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            } else {
                saveItem();
                event.preventDefault();
            }
            form.classList.add('was-validated');
        });
    });


    function saveItem() {
        $(':input[type="submit"]').prop('disabled', true);
        data = getFormData();
        dataModel = tranformDataToModel(data);

        //console.log('saveItem', dataModel);

        var url = '@Url.Action("UPDATE", ViewData["ControllerName"])';

        if (!submitIsEdit) {
            url = '@Url.Action("INSERT", ViewData["ControllerName"])';
        }

        $.ajax({
            type: "POST",
            url: url,
            data: JSON.stringify(dataModel),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }

                getItems();
                $('#new-item-modal').modal('hide');
                alertSuccess();
            },
            error: (res) => {
                alertError(res.message);
            },
            complete: () => { $(':input[type="submit"]').prop('disabled', false); }

        });
    }


    // CREATE
    function openCreateModal() {
        clearForm();
        openFormModal({ isEdit: false });
        disabledForm({ isEdit: false });
    }

    function openEditModal(id) {
        clearForm();
        $.ajax({
            type: "POST",
            url: '@Url.Action("DETAIL", ViewData["ControllerName"])?id=' + id,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                console.log('getItem', res);
                setForm(res);
                openFormModal({ isEdit: true });
                disabledForm({ isEdit: true });
            },
            error: (res) => {
                alertError(res.message);
            },
        });
    }

    // DELETE
    function clickRowDelete(id) {
        alertConfirm(deleteItem, id);
    }

    function deleteItem(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("DELETE", ViewData["ControllerName"])?id=' + id,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {

                if (res.status) {
                    getItems();
                    alertSuccess();
                }
                else {
                    alertError(res.message);
                }


            },
            error: (res) => {
                alertError(res.message);
            },
        });
    }

    function clearForm() {
        $('#form-create').removeClass('was-validated')

        if (document.getElementsByName('@ViewData["NameLower"]Id').length > 0) {
            document.getElementsByName('@ViewData["NameLower"]Id')[0].value = "";
        }
        else {
            document.getElementsByName('id')[0].value = "";
        }

        document.getElementById("form-create").reset();
    }


    function openFormModal({ isEdit }) {
        submitIsEdit = isEdit;
        if (isEdit) {
            $('#form-create-title').text('แก้ไข ');
            $('#form-create-by').show()
            $('#submit-update').show()
            $('#submit-add').hide()
        }
        else {
            $('#form-create-title').text('เพิ่ม ');
            $('#form-create-by').hide()
            $('#submit-update').hide()
            $('#submit-add').show()
        }

        var modalCreate = new bootstrap.Modal(document.getElementById('new-item-modal'), {
            keyboard: false
        })
        modalCreate.show();
    }

    const gridOptions = {
        pagination: true,
        paginationPageSize: 20,
        paginationAutoPageSize: true,
        columnDefs,
        defaultColDef: {
            flex: 1,
            minWidth: 100,
            sortable: true,
            resizable: true,
            floatingFilter: true,
        },
        autoGroupColumnDef: {
            minWidth: 100,
        },
        suppressDragLeaveHidesColumns: true
    };

    function onExportExcel() {
        gridOptions.api.exportDataAsCsv();
    }

    function tranformDataToModel(data) {
        Object.keys(data).forEach(function (key) {
            if (key in model) {
                model[key] = data[key];
            }
        });
        return model;
    }

    function clipboard(value) {
        //console.log('copy text is ' + value);

        navigator.clipboard.writeText(value);

        toastAlert('success','Success', 'Copied: ' + value + '👋');

    }

    function onlyNumberKey(evt) {

        var ASCIICode = (evt.which) ? evt.which : evt.keyCode
        if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
            return false;
        return true;
    }

    function onlyDecimalKey(evt) {

        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }

    var printModal = new bootstrap.Modal(document.getElementById('printModal'), { keyboard: false });
    const qrcode = new QRCode(document.getElementById("gen-qrcode"), {
        text: '',
        width: 65,
        height: 65,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.H
    });

    function showBarcode(codeNumber) {
        //console.log('codeNumber', codeNumber);
        printModal.show();
        qrcode.clear();
        qrcode.makeCode(codeNumber);
        $('#gen-qrcode-text').text(codeNumber);
        // JsBarcode("#gen-barcode", codeNumber, {
        //   format: "CODE39",
        //   width: 1,
        //   height: 80,
        //   fontSize: 10
        // });
    }

    function printBarcode() {
        printModal.hide();
        $(".modal-fade").modal("hide");
        $(".modal-backdrop").remove();
        var printContents = document.getElementById('section-to-print').innerHTML;
        var winPrint = window.open('', '', 'left=0,top=0,width=800,height=600,toolbar=0,scrollbars=0,status=0');
        winPrint.document.write(printContents);
        winPrint.document.close();
        winPrint.focus();
        winPrint.print();
    }

</script>