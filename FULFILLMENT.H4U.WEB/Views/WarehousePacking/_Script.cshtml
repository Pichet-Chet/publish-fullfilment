    function clipboard(value) {
        //console.log('copy text is ' + value);

        navigator.clipboard.writeText(value);

        toastAlert('success', 'Success', 'Copied: ' + value + '👋');

    }

    $('.scan-box').on('change', event => {

        $('.boxId').val(undefined);
        $('.boxDisplay').text('ไม่ระบุ');

        const boxName = $('.scan-box').val();
        //console.log('BOXS', BOXS);
        // //console.log('box', box);
        let boxData = BOXS.find((box) => box.name == boxName);
        if (boxData) {
            $('.boxId').val(boxData.id);
            $('.boxDisplay').text(boxData.name);
            //console.log(boxData);
        }
        else {
            $('.boxDisplay').text('ไม่ระบุ');
            $('.scan-box').val('');
            toastAlert('warning', 'แจ้งเตือน', 'ข้อมูล Box ที่ Scan ไม่ถูกต้อง');
        }
        //console.log(boxName);

    });

    $('.scan-box-clear').on('click', event => {
