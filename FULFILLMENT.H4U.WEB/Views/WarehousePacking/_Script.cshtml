        })
        modalBox.show();
    }

    async function getDetail(id) {
        const detail = await callApi({ type: "GET", url: '@Url.Action("DETAIL", ViewData["ControllerName"])?id=' + id });
        console.log('getItem', detail);
        setForm(detail, detail.purchaseOrderItems);
    }

    function setForm(data, items) {
        const vendor = findVendor(data.vendorId);
        document.getElementsByName('id')[0].value = data.id;
        document.getElementsByName('documentNo')[0].value = data.documentNo;
        document.getElementsByName('documentNoDisplay')[0].value = data.documentNo;
        document.getElementsByName('vendorName')[0].value = data.vendorName;

        $('#products').html('');
        items.forEach(p => {
            $('#products').append(` <div class="col-6 mb-1">${p.productName}</div> <div class="col-6 mb-1">${p.amount}</div>`);
        });
    }

    $("#form-packing").on("submit", function (e) {
        const binNumber = $("#binScan").val();
        const bin = validateBinList(binNumber);
        var form = $(this)[0];

        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }
        //else if (!parseInt($("[name='boxId']").val())) {
        //    alertWarning('กรุณาแสกน Box');
        //}
        else {
            addBox();
            event.preventDefault();
            event.stopPropagation();
        }
        form.classList.add('was-validated');
    });

    function addBox() {
        //console.log('addBox');
        $(':input[type="submit"]').prop('disabled', true);
        const data = {
            id: parseInt($("[name='id']").val()),
            boxId: parseInt($("[name='boxId']").val()),
            //boxId: 0,
            trackingNumber: $("[name='trackingNumber']").val(),
            shippingPrice: $("[name='shippingPrice']").val(),
            remark: $("[name='remark']").val(),
        }
        //console.log('data', data);
        $.ajax({
            type: "POST",
            url: '@Url.Action("UPDATE", ViewData["ControllerName"])',
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }
                getPendings();
                getItems();
                $('#new-box-modal').modal('hide');
                alertSuccess();
            },
            complete: () => { $(':input[type="submit"]').prop('disabled', false); }
        });
    }

