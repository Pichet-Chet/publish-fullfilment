    function openSelectBoxModal(id) {

        $('.boxDisplay').text('ไม่ระบุ');

        $('#form-packing').removeClass('was-validated')
        document.getElementById("form-packing").reset();
        getDetail(id)
        var modalBox = new bootstrap.Modal(document.getElementById('new-box-modal'), {
