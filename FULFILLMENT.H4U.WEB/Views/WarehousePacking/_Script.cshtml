    var printModal = new bootstrap.Modal(document.getElementById('printModal'), { keyboard: false });

    const qrcode = new QRCode(document.getElementById("gen-qrcode"), {
        text: '',
        width: 65,
        height: 65,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.H
    });
    
    function showBarcode(codeNumber) {

        $('#printModal').appendTo("body").modal('show');

        //printModal.show();
        qrcode.clear();
        qrcode.makeCode(codeNumber);
        $('#gen-qrcode-text').text(codeNumber);
    }

    function printBarcode() {
        //printModal.hide();
        $('#printModal').appendTo("body").modal('hide');

        $(".modal-fade").modal("hide");
        $(".modal-backdrop").remove();
        var printContents = document.getElementById('section-to-print').innerHTML;
        var winPrint = window.open('', '', 'left=0,top=0,width=800,height=600,toolbar=0,scrollbars=0,status=0');
        winPrint.document.write(printContents);
        winPrint.document.close();
        winPrint.focus();
        winPrint.print();
    }

