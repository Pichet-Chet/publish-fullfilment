    function onSubmitBinScan(){
        const binNumber = $("#binScan").val();
        const bin = validateBinList(binNumber);

        if (!bin) {
            alertWarning('Invalid bin number.');
            event.preventDefault();
            event.stopPropagation();
        }
        else
        {
            savePacking(bin);
        }
    }

    $(function () {
        $("#form-create").on("submit", function (e) {
            const binNumber = $("#binScan").val();
            const bin = validateBinList(binNumber);
            var form = $(this)[0];

            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            else if (!bin) {
                alertWarning('Invalid bin number.');
                event.preventDefault();
                event.stopPropagation();
            }
            else {
                savePacking(bin);
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    });

    function validateBinList(binNumber) {
        const data = BINS.find(bin => bin.binNumber === binNumber);
        return data ? data : undefined;
    }

    function savePacking(bin) {
        //console.log(bin);
        $(':input[type="submit"]').prop('disabled', true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("INSERT", ViewData["ControllerName"])',
            data: JSON.stringify({ id: 0, binId: parseInt(bin.binId) }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }
                getPendings();
                getItems();
                $('#new-item-modal').modal('hide');
                alertSuccess();



            },
            complete: () => { $(':input[type="submit"]').prop('disabled', false); }
        });
    }

