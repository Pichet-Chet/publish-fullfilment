        //console.log('getItem', detail);
        setFormDeteil(detail);
    }

    function setFormDeteil(data) {
        const poHeader = data.purchaseOrderHeader;
        const poItems = data.purchaseOrderItems;
        // const vendor = findVendor(data.vendorId);
        $("[name='fromName']").val(poHeader.fromName);
        $("[name='fromAddress']").val(poHeader.fromAddress);
        $("[name='fromTel']").val(poHeader.fromTel);
        $("[name='fromEmail']").val(poHeader.fromEmail);
        $("[name='toName']").val(poHeader.toName);
        $("[name='toAddress']").val(poHeader.toAddress);
        $("[name='toTel']").val(poHeader.toTel);
        $("[name='toEmail']").val(poHeader.toEmail);
        $("[name='remark']").val(poHeader.remark);
        $("[name='platformValue']").val(poHeader.platformValue);
        $("[name='shippingValue']").val(poHeader.shippingValue);
        $("[name='trackingNumber']").val(poHeader.trackingNumber);

        $('#products-detail').html('');

        var idx = 0;

        poItems.forEach(p => {

            idx = idx + p.amount;

            console.log(p);

            $('#products-detail').append(` <div class="col-8 mb-1"> ${p.productSku} ${p.productName} ( สี ${p.productColor} ขนาด ${p.productDescription} )</div> <div class="col-4 mb-1">${p.amount} รายการ</div>`);
        
            
        });

        $('#products-detail').append(` <div class="col-8 mb-1"> <span style="font-weight:bold;font-size:17px"> จำนวนรวมทั้งสิ้น <span>  </div> <div class="col-4 mb-1"><span style="font-weight:bold;font-size:17px">  ${idx} รายการ <span></div>`);

    }
