<!-- Modal Print Start-->
<div class="modal fade" id="printModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="printModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="printModalLabel">Print</h5>
                <button type="button" class="btn-close-x btn" data-bs-dismiss="modal" aria-label="Close">Close</button>
            </div>
            <div class="modal-body" id="section-to-print">
                <div id="gen-qrcode"></div>
                <div id="gen-qrcode-text" style="font-size: 10px;"></div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary me-1" onclick="printBarcode()">Print</button>
                <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Print End-->