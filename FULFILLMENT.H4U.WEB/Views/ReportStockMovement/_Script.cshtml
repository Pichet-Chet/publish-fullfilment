
<script>

    $(document).ready(function() {
        var gridDiv = document.querySelector('#appTable');
        new agGrid.Grid(gridDiv, gridOptions);
        gridOptions.api.sizeColumnsToFit();
        getItems();
    });

    // GET
    function getItems() {
        $.ajax({
            url: '@Url.Action("GET_STOCK_MOVE_MENT", ViewData["ControllerName"])',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getItems', res);
                var outputData = res.output_data;
                gridOptions.api.setRowData(outputData);
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    let columnDefs = [

        {
            field: 'vendorName',
            headerName: 'บริษัท - คู่ค้า',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'productName',
            headerName: 'ชื่อสินค้า',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'productSku',
            headerName: 'SKU',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'amountOld',
            headerName: 'จำนวนเดิม',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'amountChange',
            headerName: 'จำนวนที่เปลี่ยน',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'type',
            headerName: 'ประเภท',
            filter: 'agTextColumnFilter',
            minWidth: 200,
            cellRenderer: function({ value }) {

                if (value == "ADD") {
                    return '<span class="badge bg-primary w-50"> เพิ่มสต็อค </span>';
                }
                else if (value == "DELETE") {
                    return '<span class="badge bg-danger w-50"> ลดสต็อค </span>';
                }
            }
        },
        {
            field: 'reason',
            headerName: 'เหตุผล',
            minWidth: 200,
        },

    ];

    const gridOptions = {
        pagination: true,
        paginationPageSize: 20,
        paginationAutoPageSize: true,
        columnDefs,
        defaultColDef: {
            flex: 1,
            minWidth: 100,
            sortable: true,
            resizable: true,
            floatingFilter: true,
        },
        autoGroupColumnDef: {
            minWidth: 100,
        },
        suppressDragLeaveHidesColumns: true
    };

    function onFillterTable() {
        gridOptions.api.setQuickFilter(
            document.getElementById('filter-text-box').value
        );
    }


    function onExportExcel() {
        gridOptions.api.exportDataAsCsv();
    }

    function tranformDataToModel(data) {
        Object.keys(data).forEach(function(key) {
            if (key in model) {
                model[key] = data[key];
            }
        });
        return model;
    }


</script>