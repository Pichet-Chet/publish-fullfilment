            {
                field: 'productTypeName',
                headerName: 'ประเภทสินค้า',
                filter: 'agTextColumnFilter',
                minWidth: 200,
            },
            {
                field: 'productName',
                headerName: 'ชื่อสินค้า',
                filter: 'agTextColumnFilter',
                minWidth: 200,
            },
            {
                field: 'productDescription',
                headerName: 'รายละเอียด',
