                    if (value == true) {
                        return ' <span class="badge bg-warning w-50">ACTIVE</span>';
                    }
                    else {
                        return ' <span class="badge bg-secondary w-50">DISABLE</span>';
                    }
                }
            },

            {
                field: 'action',
                headerName: '',
                cellStyle: { textAlign: 'center' },
                minWidth: 50,
                width: 50,
                pinned: 'right',
                cellRenderer: function (params) {
                    return `
                        <div class="text-primary">
                            <i class="fas fa-file-image" data-toggle="tooltip" data-placement="bottom" title="เพิ่มรูปภาพ" onClick="showImageAdd('${params.data.productId}')">
                            </div>`;
                }
            },

            {
                field: 'action',
                headerName: '',
                cellStyle: { textAlign: 'center' },
                minWidth: 50,
                width: 50,
                pinned: 'right',
