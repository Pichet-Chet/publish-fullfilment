@{
    Layout = "~/Views/Shared/Template/_MasterScript.cshtml";
}

<script>
    let model = {
        productId: 0,
        productSku: null,
        productName: null,
        productDescription: null,
        productColor: null,
        vendorId: 0,
        productTypeId: 0,
        vendorSku: null,
        productHeight: null,
        productWidth: null,
        productDimension: null,
        productWeight: null,
        productLength: null,
        isActive: false,
    }

    function getFormData() {

        let formData = new FormData(document.getElementById('form-create'));

        const data = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.productId) { data.productId = 0; }

        data.productId = parseInt(data.productId);
        data.vendorId = parseInt(data.vendorId);
        data.isActive = Boolean(data.isActive);

        return data;
    }

    function disabledForm({ isEdit }) {
        if (isEdit) {
            document.getElementsByName('productSku')[0].disabled = true;
            document.getElementsByName('vendorSku')[0].disabled = true;
        }
        else {
            document.getElementsByName('productSku')[0].disabled = true;
            document.getElementsByName('vendorSku')[0].disabled = false;

        }
    }

    function setForm(data) {
        document.getElementsByName('productId')[0].value = data.productId;
        document.getElementsByName('productSku')[0].value = data.productSku;
        document.getElementsByName('productName')[0].value = data.productName;
        document.getElementsByName('productDescription')[0].value = data.productDescription;
        document.getElementsByName('productColor')[0].value = data.productColor;
        document.getElementsByName('vendorId')[0].value = data.vendorId;
        document.getElementsByName('productTypeId')[0].value = data.productTypeId;
        document.getElementsByName('vendorSku')[0].value = data.vendorSku;
        document.getElementsByName('productHeight')[0].value = data.productHeight;
        document.getElementsByName('productWidth')[0].value = data.productWidth;
        document.getElementsByName('productDimension')[0].value = data.productDimension;
        document.getElementsByName('productWeight')[0].value = data.productWeight;
        document.getElementsByName('productLength')[0].value = data.productLength;
        document.getElementsByName('isActive')[0].checked = data.isActive;

        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);
    }

    const role = document.getElementById('user-info-role-name').value;
    const vendorId = document.getElementById('user-info-vendor-id').value;

    let columnDefs = [];





    if (role === 'VENDOR' || role === 'SALE') {
        columnDefs = [
