<div class="content-body">
    <section id="dashboard-ecommerce">
        <div class="row match-height">
            <div class="col-lg-12 col-12">
                <div class="card card-company-table">
                    <div class="card-header">
                       <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-9 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon-search"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
                                    <input id="filter-text-box" type="search" class="form-control" placeholder="ค้นหา . . . . . " aria-label="Search..." aria-describedby="basic-addon-search" oninput="onFillterTable()">
                                </div>
                            </div>

                            <div class="col-12 col-sm-4 col-md-4 col-lg-1 p-1">
                                <div class="d-grid">
                                    <button type="button" class="btn btn-icon rounded-circle btn-flast-dark waves-effect float-end" onclick="getItems()">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4 col-md-4 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end" onclick="onExportExcel()">Export (.csv)</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="appTable" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal Po Detail Start -->
<div class="modal fade" id="detail-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down modal-dialog-centered">
        <div class="add-new-item modal-content pb-1">
            <div class="modal-header mb-1">
                <h5 class="modal-title">ข้อมูล</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal"
                        aria-label="Close">
                    X
                </button>
            </div>
            <div class="modal-body flex-grow-1">
                <!-- Input Start-->
                <div class="mb-1">
                    <div class="row">

                        <div class="col-lg-6">

                            <h3> รายละเอียดผู้ส่ง </h3>

                            <hr />

                            <div class="row">

                                <div class="col-lg-12">

                                    <div class="mb-1">
                                        <label class="form-label required">ชื่อ - นามสกุล ผู้ส่ง</label>
                                        <input type="text" readonly class="form-control" name="fromName" maxlength="500"
                                               required />
                                    </div>

                                </div>

                                <div class="col-lg-12">
                                    <div class="mb-1">
                                        <label class="form-label required">ที่อยู่ผู้ส่ง</label>
                                        <input type="text" readonly class="form-control" name="fromAddress"
                                               maxlength="500" required />
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="mb-1">
                                        <label class="form-label required">เบอร์โทรผู้ส่ง</label>
                                        <input type="text" readonly class="form-control" name="fromTel"
                                               onkeypress="return onlyNumberKey(event)" maxlength="10" required />
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="mb-1">
                                        <label class="form-label">อีเมลผู้ส่ง</label>
                                        <input type="email" class="form-control" name="fromEmail" maxlength="300"
                                               readonly />
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="col-lg-6">
                            <h3> รายละเอียดผู้รับ </h3>

                            <hr />

                            <div class="row">

                                <div class="col-lg-12">

                                    <div class="mb-1">
                                        <label class="form-label required">ชื่อ - นามสกุล ผู้รับ</label>
                                        <input type="text" readonly class="form-control" name="toName" maxlength="500"
                                               required />
                                    </div>

                                </div>

                                <div class="col-lg-12">
                                    <div class="mb-1">
                                        <label class="form-label required">ที่อยู่ผู้รับ</label>
                                        <input type="text" readonly class="form-control" name="toAddress"
                                               maxlength="500" required />
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="mb-1">
                                        <label class="form-label required">เบอร์โทรผู้รับ</label>
                                        <input type="text" readonly class="form-control" name="toTel"
                                               onkeypress="return onlyNumberKey(event)" maxlength="10" required />
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="mb-1">
                                        <label class="form-label">อีเมลผู้รับ</label>
                                        <input type="email" class="form-control" name="toEmail" maxlength="300"
                                               readonly />
                                    </div>
                                </div>

                            </div>
                        </div>


                    </div>

                    @*<hr />*@

                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-1">
                                <label class="form-label">หมายเหตุ</label>
                                <input type="text" readonly class="form-control" name="remark" multiple height="100"
                                       maxlength="250" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-1">
                                <label class="form-label">เลือกช่องทางการขาย</label>
                                <select class="form-select platformValue" name="platformValue" disabled>
                                    <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-1">
                                <label class="form-label">เลือกบริษัทขนส่ง</label>
                                <select class="form-select shippingValue" name="shippingValue" disabled>
                                    <option value="">--- กรุณาเลือกข้อมูล ---</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-1">
                                <label class="form-label">หมายเลขพัสดุ</label>
                                <input type="text" readonly class="form-control" name="trackingNumber" />
                            </div>
                        </div>

                    </div>

                    @*<hr>*@

                    @*<div class="text-h5 mb-2">รายการสินค้า</div>*@

                    <div class="row  d-none">
                        <div class="col-8">รายการสินค้า</div>
                        <div class="col-4">จำนวน</div>
                    </div>

                    <div class="row  d-none" id="products-detail">
                        <div class="col-8">ProductName</div>
                        <div class="col-4">Amount</div>
                    </div>

                    <!-- Input
                    </div>
                    <!-- Input End-->
                    <div class="modal-footer">
                        <div class="form-group">
                            <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Po Detail End-->
<!-- Modal to select box Start-->
<div class="modal fade" id="new-box-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down modal-dialog-centered">
        <form class="add-new-box modal-content pb-1" id="form-packing" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-create-title">แพ็คสินค้า</span></h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal"
                        aria-label="Close">
                    X
                </button>
            </div>
            <div class="modal-body flex-grow-1">

                <input type="hidden" class="form-control" name="id" />
                <input type="hidden" class="form-control" name="documentNo" />
                <input type="hidden" class="form-control" name="documentStatus" />
                <input type="hidden" class="form-control" name="purchaseOrderHeaderId" />
                <input type="hidden" class="form-control" name="vendorId" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">เลขที่เอกสาร</label>
                            <input type="text" readonly class="form-control" name="documentNoDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">บริษัท - คู่ค้า<span class="text-danger">*</span></label>
                            <input type="text" readonly class="form-control" name="vendorName" disabled />
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-lg-6">
                            <label class="form-label">กล่อง</label>
                            <div class="input-group mb-1">
                                <input name="scanBox" type="text" class="form-control scan-box" placeholder="Scan Box"
                                       aria-label="Scan Box" aria-describedby="button-scan"
                                       onkeypress="return (event.key!='Enter')">
                                <button class="btn btn-outline-primary" type="button">ค้นหา</button>
                                <button class="btn btn-outline-danger scan-box-clear" type="button">ยกเลิก</button>
                            </div>
                        </div>

                        <div class="col-lg-6 pt-1">
                            <div class="pt-lg-1"></div>
                            <div class="h2 text-muted boxDisplay text-center">ไม่ระบุ</div>
                        </div>

                        <input type="hidden" class="boxId" id="boxId" name="boxId" />

                        @*<div class="col-lg-6">
                        <div class="mb-1">
                        <label class="form-label">Box</label>
                        <select class="form-select boxId" name="boxId">
                        <option value="">--- กรุณาเลือกข้อมูล ---</option>
                        </select>
                        </div>
                        </div>*@

                        <div class="col-lg-12">
                            <div class="mb-1">
                                <label class="form-label required">Tracking No.</label>
                                <input type="text" class="form-control" name="trackingNumber" required />
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="mb-1">
                                <label class="form-label required">ค่าจัดส่ง</label>
                                <input type="text" class="form-control" name="shippingPrice"
                                       onkeypress="return onlyNumberKey(event)" required />
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="mb-1">
                                <label class="form-label">หมายเหตุ</label>
                                <input type="text" class="form-control" name="remark" />
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="text-h5 mb-2">รายการสินค้า</div>

                    <div class="row" id="products">
                        <div class="col-6">ProductName</div>
                        <div class="col-6">Amount</div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary me-1 data-submit">Save</button>
                            <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                ปิด
                            </button>
                        </div>
                    </div>

                </div>
        </form>

    </div>
</div>
<!-- Modal to add new item End-->
