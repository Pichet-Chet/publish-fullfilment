            minWidth: 200,
        },
        {
            field: 'createDate',
            headerName: 'วันที่ทำรายการ',
            filter: 'agTextColumnFilter',
            filterParams: {
                caseSensitive: true,
                textMatcher: (data) => {
                    return dateToFormat(data.value).indexOf(data.filterText) > -1;
                }
            },
            minWidth: 200,
            cellRenderer: function ({ value }) {
                if (value == null) {
                    return ' N/A ';
                }
                else {
                    return '' + dateToFormat(value, 'DD/MM/YYYY HH:mm:ss');
                }
            }
        },
        {
            field: 'documentStatus',
            headerName: 'สถานะ',
            filter: 'agTextColumnFilter',
            minWidth: 200,
            cellRenderer: function ({ value }) {
                if (value == "PACKING") {
                    return ' <span class="badge bg-warning">รอแพ็คของ</span>';
                }
            }
        },
        {
            field: '',
            headerName: '',
