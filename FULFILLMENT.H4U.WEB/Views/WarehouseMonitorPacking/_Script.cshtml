    function onFillterTable() {
        gridOptions.api.setQuickFilter(
            document.getElementById('filter-text-box').value
        );
    }


    function onExportExcel() {
        gridOptions.api.exportDataAsCsv();
    }

    function tranformDataToModel(data) {
        Object.keys(data).forEach(function (key) {
            if (key in model) {
                model[key] = data[key];
            }
        });
        return model;
    }

    function clipboard(value) {
        //console.log('copy text is ' + value);

        navigator.clipboard.writeText(value);

        toastAlert('success', 'Success', 'Copied: ' + value + '👋');

    }

    function getBins() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterBin")',
            data: { binType: 'PACKING' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getBins', res.output_data);
                BINS = res.output_data;
                createTable();
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function detailModal(id) {

        console.log(id);

        getPoDetail(id);
        var detailModal = new bootstrap.Modal(document.getElementById('detail-modal'), {
            keyboard: false
        })

        $('#detail-modal').appendTo("body").modal('show');

        //detailModal.show();

    }

    async function getPoDetail(id) {
        const detail = await callApi({ type: "GET", url: '@Url.Action("DETAIL", "WarehousePacking")?id=' + id });
        //console.log('getItem', detail);
        setFormDeteil(detail);
    }

    function setFormDeteil(data) {
        const poHeader = data.purchaseOrderHeader;
        const poItems = data.purchaseOrderItems;
        // const vendor = findVendor(data.vendorId);
        $("[name='fromName']").val(poHeader.fromName);
        $("[name='fromAddress']").val(poHeader.fromAddress);
        $("[name='fromTel']").val(poHeader.fromTel);
        $("[name='fromEmail']").val(poHeader.fromEmail);
        $("[name='toName']").val(poHeader.toName);
        $("[name='toAddress']").val(poHeader.toAddress);
        $("[name='toTel']").val(poHeader.toTel);
        $("[name='toEmail']").val(poHeader.toEmail);
        $("[name='remark']").val(poHeader.remark);
        $("[name='platformValue']").val(poHeader.platformValue);
        $("[name='shippingValue']").val(poHeader.shippingValue);
        $("[name='trackingNumber']").val(poHeader.trackingNumber);

        $('#products-detail').html('');

        var idx = 0;

        poItems.forEach(p => {

            idx = idx + p.amount;

            console.log(p);

            $('#products-detail').append(` <div class="col-8 mb-1">${p.productSku} ${p.productName} ( สี ${p.productColor} ขนาด ${p.productDescription} )</div> <div class="col-4 mb-1">${p.amount} รายการ</div>`);


        });

        $('#products-detail').append(` <div class="col-8 mb-1">จำนวนรวมทั้งสิ้น  </div> <div class="col-4 mb-1">${idx} รายการ</div>`);

    }





    function openSelectBoxModal(id) {

        $('.boxDisplay').text('ไม่ระบุ');

        $('#form-packing').removeClass('was-validated')
        document.getElementById("form-packing").reset();
        getDetail(id)
        var modalBox = new bootstrap.Modal(document.getElementById('new-box-modal'), {
            keyboard: false
        })
        modalBox.show();
    }

    async function getDetail(id) {
        const detail = await callApi({ type: "GET", url: '@Url.Action("DETAIL", "WarehousePacking")?id=' + id });
        console.log('getItem', detail);
        setForm(detail, detail.purchaseOrderItems);
    }

    function setForm(data, items) {
        const vendor = findVendor(data.vendorId);
        document.getElementsByName('id')[0].value = data.id;
        document.getElementsByName('documentNo')[0].value = data.documentNo;
        document.getElementsByName('documentNoDisplay')[0].value = data.documentNo;
        document.getElementsByName('vendorName')[0].value = data.vendorName;

        $('#products').html('');
        items.forEach(p => {
            $('#products').append(` <div class="col-6 mb-1">${p.productName}</div> <div class="col-6 mb-1">${p.amount}</div>`);
        });
    }

    $("#form-packing").on("submit", function (e) {
        const binNumber = $("#binScan").val();
        const bin = validateBinList(binNumber);
        var form = $(this)[0];

        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }
        //else if (!parseInt($("[name='boxId']").val())) {
        //    alertWarning('กรุณาแสกน Box');
        //}
        else {
            addBox();
            event.preventDefault();
            event.stopPropagation();
        }
        form.classList.add('was-validated');
    });

    function validateBinList(binNumber) {
        const data = BINS.find(bin => bin.binNumber === binNumber);
        return data ? data : undefined;
    }


    function addBox() {
        //console.log('addBox');
        $(':input[type="submit"]').prop('disabled', true);
        const data = {
            id: parseInt($("[name='id']").val()),
            boxId: parseInt($("[name='boxId']").val()),
            //boxId: 0,
            trackingNumber: $("[name='trackingNumber']").val(),
            shippingPrice: $("[name='shippingPrice']").val(),
            remark: $("[name='remark']").val(),
        }
        //console.log('data', data);
        $.ajax({
            type: "POST",
            url: '@Url.Action("UPDATE", "WarehousePacking")',
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }
                //getPendings();
                getItems();
                $('#new-box-modal').modal('hide');
                alertSuccess();
            },
            complete: () => { $(':input[type="submit"]').prop('disabled', false); }
        });
    }

