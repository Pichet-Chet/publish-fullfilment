    function getBoxs() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterBox")',
            // data: { isActive: true, binType: 'INVENTORY' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getBoxs', res.output_data);
                BOXS = res.output_data;
                //setDropdownBoxs();
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function getVendors() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "MasterVendor")',
            data: { isActive: true },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getVendors', res.output_data);
                VENDORS = res.output_data;
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    // GET
    function getItems() {
        $.ajax({
            url: '@Url.Action("GET_ALL", ViewData["ControllerName"])',
            data: { documentStatus: "PACKING" },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                console.log('getItems', res);
                var outputData = res.output_data;
                gridOptions.api.setRowData(outputData);
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    let columnDefs = [

        {
            field: 'documentNo',
