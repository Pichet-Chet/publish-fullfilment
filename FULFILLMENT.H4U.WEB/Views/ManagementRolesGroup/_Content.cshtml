@{
    Layout = "~/Views/Shared/Template/_Master.cshtml";
}

<!-- Input Start-->
<input type="hidden" class="form-control" name="id" />


<div class="row">
    <div class="col-lg-6">
        <div class="mb-1">
            <label class="form-label required">Group Code</label>
            <input type="text" class="form-control" name="value" maxlength="25" required />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="mb-1">
            <label class="form-label">Role name</label>
            <input type="text" class="form-control" name="name" maxlength="250" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="mb-1">
            <label class="form-label">Description</label>
            <input type="text" class="form-control" name="description" maxlength="250" />
        </div>
    </div>
</div>

<div class="col-lg-12">
    <div class="mb-1">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="isActive" name="isActive" value="true">
            <label class="form-check-label" for="isActive">is Active</label>
        </div>
    </div>
</div>


<!-- Input End-->