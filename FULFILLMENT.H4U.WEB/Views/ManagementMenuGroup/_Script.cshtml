@{
    Layout = "~/Views/Shared/Template/_MasterScript.cshtml";
}

<script>
    let model = {
        id: 0,
        applicationName: "FILFULLMENT",
        menuCode: null,
        menuName: null,
        menuDrsciption: null,
        menuSequence: 0,
        menuIcon: false,
    }

    function disabledForm({ isEdit }) {
        if (isEdit) {
            document.getElementsByName('menuCode')[0].disabled = true;
        }
        else {
            document.getElementsByName('menuCode')[0].disabled = false;
        }
    }

    function getFormData() {

        let formData = new FormData(document.getElementById('form-create'));

        const data = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.id) { data.id = 0; }

        data.id = parseInt(data.id);

        return data;
    }

    function setForm(data) {
        document.getElementsByName('id')[0].value = data.id;
        document.getElementsByName('applicationName')[0].value = data.applicationName;
        document.getElementsByName('menuCode')[0].value = data.menuCode;
        document.getElementsByName('menuName')[0].value = data.menuName;
        document.getElementsByName('menuDrsciption')[0].value = data.menuDrsciption;
        document.getElementsByName('menuSequence')[0].value = data.menuSequence;
        document.getElementsByName('menuIcon')[0].value = data.menuIcon;

        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);
    }

    let columnDefs = [

        {
            field: 'menuCode',
            headerName: 'Code',
            filter: 'agTextColumnFilter',
            minWidth: 20,
        },
        {
            field: 'menuName',
            headerName: 'Group Name',
            filter: 'agTextColumnFilter',
            minWidth: 20,
        },
        {
            field: 'menuDrsciption',
            headerName: 'Description',
            filter: 'agTextColumnFilter',
            minWidth: 20,
        },
        {
            field: 'menuSequence',
            headerName: 'Sequence',
            filter: 'agTextColumnFilter',
            minWidth: 20,
        },

        {
            field: 'menuIcon',
            headerName: 'Icon',
            filter: 'agTextColumnFilter',
            minWidth: 20,
        },


        {
            field: 'action',
            headerName: '#',
            cellStyle: { textAlign: 'center' },
            minWidth: 60,
            width: 60,
            pinned: 'right',
            cellRenderer: function(params) {
                return '<i class="fas fa-edit" data-toggle="tooltip" data-placement="bottom" title="แก้ไข" style="color:orange; cursor: pointer;" onClick="openEditModal(' + params.data.id + ')"></i>';
            }
        }

    ];



</script>