@{
    Layout = "~/Views/Shared/Template/_Master.cshtml";
}

<!-- Input Start-->
<input type="hidden" class="form-control" name="id" />
<input type="hidden" class="form-control" name="applicationName" value="NORMAL" />


<div class="row">
    <div class="col-lg-6">
        <div class="mb-1">
            <label class="form-label required">Menu code</label>
            <input type="text" class="form-control" name="menuCode" maxlength="25" required />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="mb-1">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="menuName" maxlength="250" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="mb-1">
            <label class="form-label">Drsciption</label>
            <input type="text" class="form-control" name="menuDrsciption" maxlength="250" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="mb-1">
            <label class="form-label">Sequence</label>
            <input type="number" class="form-control" name="menuSequence" maxlength="11" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="mb-1">
            <label class="form-label">Icon</label>
            <input type="text" class="form-control" name="menuIcon" maxlength="250" />
        </div>
    </div>
</div>


<!-- Input End-->