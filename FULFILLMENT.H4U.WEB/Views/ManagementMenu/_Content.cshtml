                    </div>
                    <div class="card-body">
                        <div id="appTable" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal to add new item Start-->
<div class="modal fade" id="new-item-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down modal-dialog-centered">
        <form class="add-new-item modal-content pb-1" id="form-create" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title"><span id="form-create-title"></span> @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body flex-grow-1">

                <input type="hidden" class="form-control" name="id" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">APP</label>
                            <input type="text" class="form-control" name="applicationName" maxlength="100" value="FILFULLMENT" disabled required />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">Code</label>
                            <input type="text" class="form-control" name="menuCode" maxlength="100" required />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">Name</label>
                            <input type="text" class="form-control" name="menuName" maxlength="100" required />
                        </div>
                    </div>


                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">Description</label>
                            <input type="text" class="form-control" name="menuDesciption" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">Sequence</label>
                            <input type="number" class="form-control" name="menuSequence" maxlength="100" required />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">Icon</label>
                            <input type="text" class="form-control" name="menuIcon" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">Controller</label>
                            <input type="text" class="form-control" name="controller" maxlength="100" required />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">Action</label>
                            <input type="text" class="form-control" name="action" maxlength="100" required />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="mb-1">
                            <label class="form-label required">Group Menu</label>
                            <select class="form-select required" name="menuGroup" required>
                                <option value="">--- กรุณาเลือกข้อมูล ---</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="mb-1">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="isActive" name="isActive" value="true">
                                <label class="form-check-label" for="isActive">is Active</label>
                            </div>
                        </div>
                    </div>

                </div>

                <ul id="form-create-by" class="list-unstyled fs-6 text-secondary d-none">
                    <li>
                        <span class="me-25">วันที่แก้ไข</span>
                        <span id="form-create-update-by"></span> <span id="form-create-update-date"></span>
                    </li>
                    <li>
                        <span class="me-25">วันที่ทำรายการ:</span>
                        <span id="form-create-create-by"></span> <span id="form-create-create-date"></span>
                    </li>
                </ul>

                <div class="modal-footer">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-1 data-submit" id="submit-add">บันทึก</button>
                        <button type="submit" class="btn btn-primary me-1 data-submit" id="submit-update">Save</button>
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
<!-- Modal to add new item End-->