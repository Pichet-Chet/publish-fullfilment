
<script>

    $(document).ready(function() {
        var gridDiv = document.querySelector('#appTable');
        new agGrid.Grid(gridDiv, gridOptions);
        gridOptions.api.sizeColumnsToFit();
        getItems();
    });

    // GET
    function getItems() {
        $.ajax({
            url: '@Url.Action("GET_ALL", ViewData["ControllerName"])',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getItems', res);
                var outputData = res.output_data;
                gridOptions.api.setRowData(outputData);
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }


    let model = {
        id: 0,
        applicationName: "FILFULLMENT",
        menuCode: null,
        menuName: null,
        menuDesciption: null,
        menuSequence: 0,
        menuIcon: null,
        controller: null,
        action: null,
        menuGroup: null,
        isActive: false,

    }

    function getFormData() {

        let formData = new FormData(document.getElementById('form-create'));

        const data = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.id) { data.id = 0; }

        data.id = parseInt(data.id);
        data.menuSequence = parseInt(data.menuSequence);
        data.isActive = Boolean(data.isActive);


        return data;
    }


    // CREATE
    let submitIsEdit = false;

    $(function() {
        $("#form-create").on("submit", function(e) {
            var form = $(this)[0];
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            } else {
                saveItem();
                event.preventDefault();
            }
            form.classList.add('was-validated');
        });
    });


    function saveItem() {
        data = getFormData();
        dataModel = tranformDataToModel(data);

        //console.log('saveItem', dataModel);

        var url = '@Url.Action("UPDATE", ViewData["ControllerName"])';

        if (!submitIsEdit) {
            url = '@Url.Action("INSERT", ViewData["ControllerName"])';
        }

        $.ajax({
            type: "POST",
            url: url,
            data: JSON.stringify(dataModel),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function(res) {
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }

                getItems();
                $('#new-item-modal').modal('hide');
                alertSuccess();
            },
            error: (res) => {
                alertError(res.message);
            },

        });
    }


    // CREATE
    function openCreateModal() {
        clearForm();
        openFormModal({ isEdit: false })
    }

    function openEditModal(id) {
        clearForm();
        $.ajax({
            type: "POST",
            url: '@Url.Action("DETAIL", ViewData["ControllerName"])?id=' + id,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                //console.log('getItem', res);
                setForm(res);
                openFormModal({ isEdit: true })
            },
            error: (res) => {
                alertError(res.message);
            },
        });
    }


    function clearForm() {
        $('#form-create').removeClass('was-validated')

        if (document.getElementsByName('@ViewData["NameLower"]Id').length > 0) {
            document.getElementsByName('@ViewData["NameLower"]Id')[0].value = "";
        }
        else {
            document.getElementsByName('id')[0].value = "";
        }

        document.getElementById("form-create").reset();
    }


    function openFormModal({ isEdit }) {
        submitIsEdit = isEdit;
        if (isEdit) {
            $('#form-create-title').text('แก้ไข ');
            $('#form-create-by').show()
            $('#submit-update').show()
            $('#submit-add').hide()
        }
        else {
            document.getElementsByName('menuCode')[0].disabled = false;
            $('#form-create-title').text('เพิ่ม ');
            $('#form-create-by').hide()
            $('#submit-update').hide()
            $('#submit-add').show()
        }

        var modalCreate = new bootstrap.Modal(document.getElementById('new-item-modal'), {
            keyboard: false
        })
        modalCreate.show();
    }



    function setForm(data) {
        document.getElementsByName('id')[0].value = data.id;
        document.getElementsByName('applicationName')[0].value = data.applicationName;
        document.getElementsByName('menuCode')[0].value = data.menuCode;
        document.getElementsByName('menuCode')[0].disabled = true;
        document.getElementsByName('menuName')[0].value = data.menuName;
        document.getElementsByName('menuDesciption')[0].value = data.menuDesciption;
        document.getElementsByName('menuSequence')[0].value = data.menuSequence;
        document.getElementsByName('menuIcon')[0].value = data.menuIcon;
        document.getElementsByName('controller')[0].value = data.controller;
        document.getElementsByName('action')[0].value = data.action;
        document.getElementsByName('menuGroup')[0].value = data.menuGroup;
        document.getElementsByName('isActive')[0].checked = data.isActive;

        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);
    }

    let columnDefs = [

        {
            field: 'menuCode',
            headerName: 'Code',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'menuName',
            headerName: 'Group Name',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'menuDesciption',
            headerName: 'Description',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'controller',
            headerName: 'Controller',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'action',
            headerName: 'Action',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'menuSequence',
            headerName: 'Sequence',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },

        {
            field: 'menuIcon',
            headerName: 'Icon',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'isActive',
            headerName: 'is Active',
            filter: 'agTextColumnFilter',
            minWidth: 200,
            cellRenderer: function({ value }) {
                if (value == true) {
                    return ' <span class="badge bg-warning">ACTIVE</span>';
                }
                else {
                    return ' <span class="badge bg-secondary">DISABLE</span>';
                }
            }
        },

        {
            field: 'action',
            headerName: '#',
            cellStyle: { textAlign: 'center' },
            minWidth: 60,
            width: 60,
            pinned: 'right',
            cellRenderer: function(params) {
                return '<div><i class="fas fa-edit" data-toggle="tooltip" data-placement="bottom" title="แก้ไข" style="color:orange; cursor: pointer;" onClick="openEditModal(' + params.data.id + ')"> ';
            }
        }

    ];

    const gridOptions = {
        pagination: true,
        paginationPageSize: 20,
        paginationAutoPageSize: true,
        columnDefs,
        defaultColDef: {
            flex: 1,
            minWidth: 100,
            sortable: true,
            floatingFilter: true,
        },
        autoGroupColumnDef: {
            minWidth: 100,
        },
        suppressDragLeaveHidesColumns: true
    };

    function onFillterTable() {
        gridOptions.api.setQuickFilter(
            document.getElementById('filter-text-box').value
        );
    }


    function onExportExcel() {
        gridOptions.api.exportDataAsCsv();
    }

    function tranformDataToModel(data) {
        Object.keys(data).forEach(function(key) {
            if (key in model) {
                model[key] = data[key];
            }
        });
        return model;
    }


    getDropdownGroup();


    function getDropdownGroup() {
        $.ajax({
            url: '@Url.Action("GET_GROUP", ViewData["ControllerName"])',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: (res) => {
                res.output_data.forEach((d) => {
                    $('[name="menuGroup"]').append(`<option value="${d.id}">${d.menuCode}</option>`);
                })
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });

    }

</script>