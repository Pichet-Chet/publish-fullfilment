<style>
    .blink {
      animation: blink-animation 1s steps(5, start) infinite;
      -webkit-animation: blink-animation 1s steps(5, start) infinite;
    }
    @@keyframes blink-animation {
      to {
        visibility: hidden;
      }
    }
    @@-webkit-keyframes blink-animation {
      to {
        visibility: hidden;
      }
    }
</style>

<div class="content-body">
    <section id="dashboard-ecommerce">
        <div class="row match-height">
            <div class="col-lg-12 col-12">
                <div class="card card-company-table">
                    <div class="card-header">

                        <div class="row">
                            <div class="col-12 col-lg-8 p-1">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon-search"><svg
                                            xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round"
                                            class="feather feather-search">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg></span>
                                    <input id="filter-text-box" type="search" class="form-control"
                                        placeholder="ค้นหา . . . . . " aria-label="Search..."
                                        aria-describedby="basic-addon-search" oninput="onFillterTable()">
                                </div>
                            </div>

                            <div class="col-12 col-sm-2 col-lg-1 p-1">
                                <div class="d-grid">
                                    <span id="noti-order" class="badge badge-light-warning py-1 blink">
                                        <i class="fa fa-shopping-basket"></i>
                                        <span id="noti-order-number"></span>
                                    </span>
                                </div>
                            </div>

                            <div class="col-12 col-sm-2 col-lg-1 p-1">
                                <div class="d-grid">
                                    <button type="button"
                                        class="btn btn-icon rounded-circle btn-flast-dark waves-effect float-end"
                                        onclick="getItems()">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>
                          
                            <div class="col-12 col-sm-4 col-lg-2 p-1">
                                <div class="d-grid">
                                    <button class="btn btn-outline-success float-end"
                                        onclick="onExportExcel()">Export (.csv)</button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="card-body">
                        <div id="appTable" style="height: 530px;" class="ag-theme-alpine"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

