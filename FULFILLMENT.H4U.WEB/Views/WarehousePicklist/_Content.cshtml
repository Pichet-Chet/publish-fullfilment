<!-- Modal to add new item Start-->
<div class="modal fade" id="new-item-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div id="vue-app" class="modal-dialog modal-xl modal-fullscreen-xl-down modal-dialog-centered">
        <form class="add-new-item modal-content pb-1" id="form-create" action="" method="post" novalidate>
            <div class="modal-header mb-1">
                <h5 class="modal-title">เพิ่มรายการ @ViewData["Name"]</h5>
                <button type="button" class="btn-close-x btn bg-danger" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body flex-grow-1">

                <!-- "id": 0,
                "documentNo": "string",
                "documentStatus": "string",
                "vendorId": 0,
                "purchaseOrderHeaderId": 0, -->

                <!-- Input Start-->
                <input type="hidden" class="form-control" name="id" />
                <input type="hidden" class="form-control" name="documentNo" />
                <input type="hidden" class="form-control" name="documentStatus" />
                <input type="hidden" class="form-control" name="purchaseOrderHeaderId" />
                <input type="hidden" class="form-control" name="vendorId" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label required">เลขที่เอกสาร</label>
                            <input type="text" class="form-control" name="documentNoDisplay" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-1">
                            <label class="form-label">บริษัท - คู่ค้า<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="vendorIdDisplay" disabled />
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <label class="form-label required">Bin</label>
                        <div class="input-group mb-1">
                            <input name="scanBin" type="text" class="form-control scan-bin"
                                placeholder="Scan Bin" aria-label="Scan Bin"
                                aria-describedby="button-scan" onkeypress="return (event.key!='Enter')" required>
                            <button class="btn btn-outline-primary" type="button">ค้นหา</button>
                            <button class="btn btn-outline-danger scan-bin-clear" type="button">ยกเลิก</button>
                        </div>
                        <!-- <div class="mb-1"> -->
                            <!-- <input type="hidden" name="binId" class="binId"> -->
                            <!-- <label class="form-label required">Bin</label>
                            <select class="form-select binId" name="binId" required>
                            </select> -->
                        <!-- </div> -->
                    </div>
                    <div class="col-6 col-lg-3 pt-1">
                        <div class="pt-1"></div>
                        <div class="h2 text-muted binDisplay text-center">ไม่ระบุ</div>
                        <input type="hidden" name="binId" class="binId">
                    </div>


                    <!-- <div class="col-lg-6">
                        <div class="mb-1">
                            <button class="btn btn-outline-primary mt-2" onclick="openModalScan()">Scan Bin or
                                sheft</button>
                        </div>
                    </div> -->

                    <hr>

                    <div class="col-lg-12">

                        <div class="mb-1">
                            <h5>รายละเอียดรายการสินค้า</h5>
                            <!-- <pre>{{validate}}</pre> -->

                            <div v-for="(product, pdIndex) in picklistProducts" class="card shadow-sm"
                                :style="{'background-color': cardValidateColor(product.productId)}">
                                <div class="card-body">

                                    <div class="row">
                                        <div class="col-12 col-xl-6 text-warning h4">{{product.productName}} <span style="font-size:18px"> ( SKU : {{product.productSku}} )</span> </div>
                                        <div class="col-6 col-lg-3 h2"><span class="text-muted">จำนวน: </span>
                                            {{product.amount}}</div>
                                        <div class="col-6 col-lg-3 h2"><span class="text-muted">หยิบออก: </span>
                                            {{sumPick(product.stocks)}}</div>

                                        <!-- scan -->
                                        <div class="col-12">
                                            <div class="input-group my-1">
                                                <!-- <input :id="'scanBinSheft'+(pdIndex+1)" type="text" class="form-control"
                                                    placeholder="Scan Bin - Sheft" aria-label="Scan Bin - Sheft"
                                                    aria-describedby="button-scan" v-model="product.scan.input"
                                                    required> -->
                                                <input :id="'scanBinSheft'+(pdIndex+1)" :ref="'scanBinSheft'+(pdIndex+1)" type="text" class="form-control"
                                                    placeholder="Scan Bin - Sheft" v-model="product.scan.input" @@input="onScanBinSheft($event, pdIndex)" :disabled="product.scan.disabled">
                                                <!-- <button class="btn btn-outline-danger" type="button" v-on:click="product.scan.input=''">ยกเลิก</button> -->
                                            </div>
                                        </div>
                                        <!-- scan -->

                                        <div class="col-12">
                                            <div class="row text-h6 mt-1" :class="!product.scan.disabled && (stock.binName===product.scan.bin?.binName || stock.sheftName===product.scan.sheft?.sheftName)?'text-primary bg-light rounded':''" v-for="stock in product.stocks">
                                                <div class="col-6 col-lg-9">
                                                    <div class="row">
                                                        <div class="col-12 col-lg-4 h3" :class="!product.scan.disabled && stock.binName===product.scan.bin?.binName?'text-success':''">
                                                            <span class="text-muted h3">
                                                                bin:
                                                            </span> {{stock.binName}}</div>
                                                        <div class="col-12 col-lg-4 h3" :class="!product.scan.disabled && stock.sheftName===product.scan.sheft?.sheftName?'text-success':''">
                                                            <span class="text-muted h3">
                                                                sheft:
                                                            </span> {{stock.sheftName}}</div>
                                                        <div class="col-12 col-lg-2 h3">
                                                            <span class="text-muted h3">
                                                                stock:
                                                            </span> {{stock.amount}}</div>
                                                    </div>
                                                </div>
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col-12 text-right">
                                                            <!-- <b class="text-success">{{stock.pick}}</b> -->

                                                            <input type="number" min="0" :max="stock.amount"
                                                                class="form-control form-control-sm"
                                                                :class="stock.pick>stock.amount?'is-invalid':''"
                                                                placeholder="pick" v-model="stock.pick" disabled>

                                                            <!-- <input type="number" min="0" :max="stock.amount"
                                                                class="form-control form-control-sm"
                                                                :class="stock.pick>stock.amount?'is-invalid':''"
                                                                placeholder="pick" v-model="stock.pick" :disabled="!(stock.binName===product.scan.input || stock.sheftName===product.scan.input)"> -->
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- Input End-->

                <div class="modal-footer">
                    <div class="form-group">
                        <button type="button" v-on:click="save()" class="btn btn-primary me-1 data-submit"
                            id="submit-update">บันทึก</button>
                        <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>
            </div>
        </form>

    </div>
</div>
<!-- Modal to add new item End-->

<!-- warning toast -->
<div class="toast warning-toast position-fixed top-0 end-0 text-white bg-warning border-0" style="z-index: 1500;" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
    <div class="d-flex">
      <div class="toast-body warning-toast-message">ข้อมูลที่ Scan ไม่ถูกต้อง</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
<!-- warning toast ends -->