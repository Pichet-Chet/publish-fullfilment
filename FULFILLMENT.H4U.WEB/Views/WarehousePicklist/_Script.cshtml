                                headerId: 0,
                                productId: product.productId,
                                productSku: product.productSku,
                                amount: stock.pick,
                                atLocation: 1,
                                atSheft: stock.atSheft,
                                atBin: stock.atBin,
                            });
                        }
                    })
                });

                return data;
            },
