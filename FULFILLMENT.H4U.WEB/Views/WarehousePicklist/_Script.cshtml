            tranFromData: function (poDetail, poItems, masterStocks) {
                let list = [];
                poItems.forEach(item => {

                    let stocks = [];
                    masterStocks.forEach(stock => {
                        if (item.productId === stock.productId) {
                            stocks.push({
                                atBin: stock.binId,
                                binName: stock.binName,
                                atSheft: stock.sheftId,
                                sheftName: stock.sheftName,
                                atLocation: 1,
                                amount: stock.amount,
                                pick: 0,
                            });
                        }
                    });

                    list.push({
                        productId: item.productId,
                        productName: item.productName,
                        productSku: item.productSku,
                        amount: item.amount,
                        stocks: stocks,
                        scan: {
                            input: '',
                            bin: null,
                            binPick: 0,
                            sheft: null,
                            sheftPick: 0,
                        },
                    });

                })


                return list
            },
            sumPick: function (stocks) {
                let sum = 0;
                stocks.forEach(s => {
                    sum = parseInt(s.pick ? s.pick : 0) + parseInt(sum)
                });
                return parseInt(sum);
            },
            validatePickProducts: function (scanIndex) {
                this.validate.picks = [];
                this.validate.successPicks = [];
                this.validate.errorPicks = [];

                this.picklistProducts.forEach((pd, index) => {
                    if (parseInt(pd.amount) < this.sumPick(pd.stocks)) {
                        this.validate.errorPicks.push(pd.productId);
                    }
                    else if (parseInt(pd.amount) === this.sumPick(pd.stocks)) {
                        this.validate.successPicks.push(pd.productId);
                        this.picklistProducts[index].scan.disabled = true;
                        if (scanIndex + 1 < this.picklistProducts.length) {
                            document.getElementById('scanBinSheft' + (scanIndex + 2)).focus();
                        }
                    }
                    else if (parseInt(pd.amount) != this.sumPick(pd.stocks)) {
                        this.validate.picks.push(pd.productId);
                    }
                });
                return this.validate.picks;
            },
            validateMoreStock: function () {
                this.validate.stocks = [];
                this.picklistProducts.forEach(pd => {
                    pd.stocks.forEach(s => {
                        if (parseInt(s.stock) < parseInt(s.pick)) {
                            this.validate.stocks.push(s.binName + s.sheftName);
                        }
                    });
                });
                return this.validate.stocks;
            },
            getData: function () {

                let data = { header: {}, item: [] };
                data.header = getFormData();
                data.item = [];

                this.picklistProducts.forEach(product => {
                    product.stocks.forEach(stock => {
                        if (parseInt(stock.pick) > 0) {
                            data.item.push({
