            getDetail: async function (id) {
                this.validate.picks = [];
                this.validate.successPicks = [];
                this.validate.errorPicks = [];
                const getDetail = await callApi({ type: "GET", url: '@Url.Action("DETAIL", "RequestPurchaseOrder")?id=' + id });
                //console.log('getItem', getDetail);
                setForm(getDetail);

