            $('.scan-bin').val('');
            $('.binId').val('');
            $('.binDisplay').text('ไม่ระบุ');
            // toastAlert('warning','แจ้งเตือน', 'ข้อมูล Bin ที่ Scan ไม่ถูกต้อง');
            openToastWarning({ message: 'ข้อมูล Bin ที่ Scan ไม่ถูกต้อง' });
        }
    });

    $('.scan-bin-clear').click(() => {
        $('.scan-bin').val('');
        $('.binId').val('');
        $('.binDisplay').text('ไม่ระบุ');
    });

    var showBasicToast = new bootstrap.Toast($('.warning-toast'));

    function openToastWarning({ message }) {
        $('.warning-toast-message').text(message)
        showBasicToast.show();
    }

</script>