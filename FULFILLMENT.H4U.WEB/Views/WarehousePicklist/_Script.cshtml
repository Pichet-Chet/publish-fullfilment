                    return;
                }

                if (this.validate.successPicks.length != this.picklistProducts.length) {
                    alertWarning('The number of products picked is incorrect.');
                    return;
                }
                saveItem(data);
            },

            cardValidateColor: function (productId) {
                if (this.validate.successPicks.includes(productId)) {
                    return '#d5ffcb';
                }
                else if (this.validate.errorPicks.includes(productId)) {
