            onScanBinSheft(event, i) {
                const scanInput = event.target.value;

                // STEP-1: SCAN BIN OR SHEFT  
                if (scanInput !== this.picklistProducts[i].productSku) {
                    this.picklistProducts[i].scan.bin = null;
                    this.picklistProducts[i].scan.sheft = null;
                    if (scanInput != undefined) {
                        let binData = BINS.find((bin) => bin.binNumber === scanInput);
                        let sheftData = SHEFT.find((sheft) => sheft.sheftName === scanInput);
                        // console.log('scanInput', scanInput);
                        // console.log('binData', binData);
                        // console.log('sheftData', sheftData);

                        if (binData) {
                            this.picklistProducts[i].scan.bin = binData;
                        }
                        else if (sheftData) {
                            const haveBin = this.picklistProducts[i].stocks.find((s) => s.atSheft === sheftData.sheftId && s.atBin !== 0);
                            if (haveBin) {
                                openToastWarning({ message: 'โปรด Scan Bin' });
                            }
                            else {
                                this.picklistProducts[i].scan.sheft = sheftData;
                            }
                        }
                        else {
                            if (scanInput != '') {
                                openToastWarning({ message: 'ข้อมูลที่ Scan ไม่ถูกต้อง' });
                            }
                        }
                    }
                }
                // STEP-2: SCAN PRODUCT_CODE
                else if (this.picklistProducts[i].scan.bin !== null || this.picklistProducts[i].scan.sheft !== null) {
                    let stockIndex = '';
                    if (this.picklistProducts[i].scan.bin) {
                        stockIndex = this.picklistProducts[i].stocks.findIndex(s => s.atBin === this.picklistProducts[i].scan.bin.binId);
                    }
                    else {
                        stockIndex = this.picklistProducts[i].stocks.findIndex(s => s.atSheft === this.picklistProducts[i].scan.sheft.sheftId);
                    }
                    // PICK++
                    if (this.picklistProducts[i].stocks[stockIndex].amount > this.picklistProducts[i].stocks[stockIndex].pick) {
                        this.picklistProducts[i].stocks[stockIndex].pick += 1;
                    }
                    else {
                        openToastWarning({ message: 'ไม่มีสินค้าใน stock' });
                    }
                }

                this.picklistProducts[i].scan.input = '';

                this.validatePickProducts(i);
                this.validateMoreStock();
            }
        },

