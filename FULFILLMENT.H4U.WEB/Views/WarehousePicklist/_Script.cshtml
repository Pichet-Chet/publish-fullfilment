<script>
    let FIRST_ORDERS = [];
    let NOTI_ORDERS = [];

    $(document).ready(function () {
        var gridDiv = document.querySelector('#appTable');
        new agGrid.Grid(gridDiv, gridOptions);
        getItems();
    });

    // GET
    function getItems() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "RequestPurchaseOrder")',
            contentType: "application/json; charset=utf-8",
            data: { documentStatus: "PENDING" },
            dataType: "json",
            success: (res) => {
                //console.log('getItems', res);
                let orders = res.output_data;
                FIRST_ORDERS = orders.map(order => order.documentNo);
                gridOptions.api.setRowData(orders);
                $('#noti-order').hide();
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    function getItemsForNotification() {
        $.ajax({
            url: '@Url.Action("GET_ALL", "RequestPurchaseOrder")',
            contentType: "application/json; charset=utf-8",
            data: { documentStatus: "PENDING" },
            dataType: "json",
            success: (res) => {
                //console.log('getItemsForNotification', res);
                checkNotification(res.output_data);
            },
            error: (res) => {
                alertError(res.statusText);
            },
        });
    }

    // setTimeout(() => {  getItemsForNotification(); }, 3000);

    setInterval(() => {
        getItemsForNotification();
    }, 60000);

    $('#noti-order').hide();
    function checkNotification(newOrders) {
        //console.log('checkNotification');
        let newItems = newOrders.map(order => order.documentNo);
        // get only out of first orders
        newItems = newItems.filter(order => !FIRST_ORDERS.includes(order)).sort();

        //console.log('NOTI_ORDERS >', NOTI_ORDERS);
        //console.log('newItems >', newItems);

        if (!arraysEqual(newItems, NOTI_ORDERS)) {
            //console.log('noti !!!!');
            NOTI_ORDERS = newItems;
            $('#noti-order').show();
            $('#noti-order-number').text(`New order (${NOTI_ORDERS.length})`)
        }

        // //console.log('FIRST_ORDERS', FIRST_ORDERS);
        // //console.log('newItems', newItems);
        // //console.log('NOTI_ORDERS', NOTI_ORDERS);

    }

    function arraysEqual(a1, a2) {
        return JSON.stringify(a1) == JSON.stringify(a2);
    }

    function onFillterTable() {
        gridOptions.api.setQuickFilter(
            document.getElementById('filter-text-box').value
        );
    }

    function saveItem(data) {
        $('#submit-update').prop('disabled', true);
        //console.log('saveItem', data);
        var url = '@Url.Action("INSERT", ViewData["ControllerName"])';
        $.ajax({
            type: "POST",
            url: url,
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                getItems();
                if (res.status === false) {
                    alertError(res.message);
                    return;
                }
                $('#new-item-modal').modal('hide');
                alertSuccess();
            },
            error: (res) => {
                alertError(res.message);
            },
            complete: () => { $('#submit-update').prop('disabled', false); }
        });
    }

