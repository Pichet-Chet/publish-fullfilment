    <script>

        const SECRET_KEY = '0x4AAAAAAAFD-pycW73KGzF7luxih25rMBg';

        window.onloadTurnstileCallback = function () {
            turnstile.render('#example-container', {
                sitekey: '0x4AAAAAAAFD-pI4ySIjm_ky',
                callback: function (token) {
                    //console.log(`Challenge Success ${token}`);
                },
            });
        };

        $(window).on('load', function () {
            if (feather) {
                feather.replace({
                    width: 14,
                    height: 14
                });
            }
        })


        $(function () {
            $("#form-authentication-signin").on("submit", function (e) {

                event.preventDefault();

                var form = $(this)[0];

                if (form.checkValidity() === false) {

                    event.stopPropagation();

                } else {

                    onSave();
                }

                form.classList.add('was-validated');
            });
        });

        function onSave() {

            var model = new modelMapping();

            $.ajax({
                type: "post",
                url: '@Url.Action("AuthorizeUser", "Authentication")',
                data: JSON.stringify(model),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.status) {
                        window.location.href = '@Url.Action("Index","Home")';
                    } else {
                        alertError(data.message);
                    }
                },
                erro: function () {
                    alertError(data.message);
                }
            });
        }

        function modelMapping() {

            var model = new Object();

            model.email = $('#login-email').val();
            model.userPassword = $('#login-password').val();

            return model;
        }

    </script>
