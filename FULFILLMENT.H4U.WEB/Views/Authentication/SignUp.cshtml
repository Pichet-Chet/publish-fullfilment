    <script src="~/app-assets/js/core/app.js"></script>
    <script src="~/app-assets/js/scripts/pages/auth-register.js"></script>
    <script src="~/app-assets/lib/custom.js"></script>


    <script>


        $(document).ready(function() {
            //getVenderAll();
        });

        $(window).on('load', function() {
            if (feather) {
                feather.replace({
                    width: 14,
                    height: 14
                });
            }
        })


        $(function() {
            $("#form-authentication-signup").on("submit", function(e) {

                event.preventDefault();

                var form = $(this)[0];

                if (form.checkValidity() === false) {

                    event.stopPropagation();

                } else {

                    onSave();
                }

                form.classList.add('was-validated');
            });
        });

        function onSave() {

            var model = new modelMapping();
            //////////console.log(model);

            if ($('#register-password').val() == $('#register-password-confirm').val()) {
                $.ajax({
                    type: "post",
                    url: '@Url.Action("Register", "Authentication")',
                    data: JSON.stringify(model),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.status) {
                            alertSuccess(data.message);

                            setTimeout(() => {
                                window.location.href = '@Url.Action("SignIn","Authentication")';
                            }, 3500);


                        } else {
                            alertError(data.message);
                        }
                    },
                    erro: function () {
                        alertError(data.message);
                    }
                });
            }
            else {
                alertError("Your password and confirmation password do not match.");
            }
            
        }

        function modelMapping() {

            var model = new Object();

            model.userId = 0;
            model.userName = $('#register-username').val();
            model.userPassword = $('#register-password').val();
            model.firstNameth = $('#register-firstname-th').val();
            model.lastNameth = $('#register-lastname-th').val();
            model.firstNameen = $('#register-firstname-en').val();
            model.lastNameen = $('#register-lastname-en').val();
            model.mobile = $('#register-tel').val();
            model.email = $('#register-email').val();
            //model.venderId = parseInt($('#ddlSignupVenderSelect option:selected').val());
            model.secretKey = $('#register-secret-key').val();
            model.isActive = true;


            return model;
        }


