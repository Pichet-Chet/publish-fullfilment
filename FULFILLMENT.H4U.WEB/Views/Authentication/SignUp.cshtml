        <div class="content-wrapper">
            <div class="content-header row">
            </div>
            <div class="content-body">
                <div class="auth-wrapper auth-cover">
                    <div class="auth-inner row m-0">
                        <!-- Brand logo--><a class="brand-logo" href="@Url.Action("Signup","Authentication")">
                            <img src="~/logo/H4U-logo.png" width="250" />
                        </a>
                        <!-- /Brand logo-->
                        <!-- Left Text-->
                        <div class="d-none d-lg-flex col-lg-8 align-items-center p-5">
                            <div class="w-100 d-lg-flex align-items-center justify-content-center px-5"><img class="img-fluid" src="~/app-assets/images/pages/register-v2.svg" alt="Register V2" /></div>
                        </div>
                        <!-- /Left Text-->
                        <!-- Register-->
                        <div class="d-flex col-lg-4 align-items-center auth-bg px-2 p-lg-5">
                            <div class="col-12 col-sm-8 col-md-6 col-lg-12 px-xl-2 mx-auto">
                                <h2 class="card-title fw-bold mb-1">สมัครสมาชิกระบบ Here4U Fulfillment </h2>
                                <p class="card-text mb-2">Make your warehouse management easy and fun!</p>
                                <form class="auth-register-form mt-2" id="form-authentication-signup" action="" method="POST" novalidate>
                                    <div class="mb-1">
                                        <label class="form-label">Username <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-username" placeholder="johndoe" autofocus="" tabindex="1" required />
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">Email <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-email" placeholder="john@example.com" tabindex="2" required />
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">Password <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-merge form-password-toggle">
                                            <input class="form-control form-control-merge" id="register-password" type="password" placeholder="············" aria-describedby="register-password" tabindex="3" /><span class="input-group-text cursor-pointer"><i data-feather="eye"></i></span>
                                        </div>
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">Password Confirm <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-merge form-password-toggle">
                                            <input class="form-control form-control-merge" id="register-password-confirm" type="password" placeholder="············" aria-describedby="register-password" tabindex="3" /><span class="input-group-text cursor-pointer"><i data-feather="eye"></i></span>
                                        </div>
                                    </div>

                                    <div class="mb-1">
                                        <label class="form-label">ชื่อ <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-firstname-th" tabindex="4" required />
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">นามสกุล <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-lastname-th" tabindex="5" required />
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">First name <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-firstname-en" tabindex="6" required />
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">Surname <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-lastname-en" tabindex="7" required />
                                    </div>

                                    <div class="mb-1">
                                        <label class="form-label">เบอร์โทร <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" id="register-tel" tabindex="8" required />
                                    </div>

                                    @*<div class="mb-1">
                                        <label class="form-label" for="register-username">บริษัทคู่ค้า <span class="text-danger">*</span></label>
                                        <select class="form-select" id="ddlSignupVenderSelect" required>
                                            <option value="0">--- กรุณาเลือกข้อมูล ---</option>
                                        </select>
                                    </div>*@
                                    <div class="mb-1">
                                        <label class="form-label" for="register-username">รหัสบริษัทคู่ค้า <span class="text-danger">*</span></label>
                                        <input class="form-control" id="register-secret-key" type="text" tabindex="9" required />
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100" tabindex="10">ยืนยันสมัครสมาชิก</button>

                                </form>
                                <p class="text-center mt-2"><span>มีบัญชีใช้งานอยู่แล้ว ?</span><a href="@Url.Action("SignIn","Authentication")"><span>&nbsp; เข้าสู่ระบบ</span></a></p>
                            </div>
                        </div>
                        <!-- /Register-->
                    </div>
                </div>
            </div>
