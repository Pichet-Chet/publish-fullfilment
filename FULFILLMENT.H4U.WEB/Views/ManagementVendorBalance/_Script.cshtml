@{
    Layout = "~/Views/Shared/Template/_MasterScript.cshtml";
}

<script>
    let model = {
        vendorId: 0,
        balance: 0,
        //prefixName: null,
        vendorCode: null,
        vendorName: null,
        taxId: null,
        contactName: null,
        contactTel: null,
        contactAddress: null,
        lineId: null,
        email: null,
        website: null,
        serectKey: null,
        isActive: false,
    }

    function getFormData() {

        let formData = new FormData(document.getElementById('form-create'));

        const data = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.vendorId) { data.vendorId = 0; }

        data.vendorId = parseInt(data.vendorId);
        data.balance = parseFloat(data.balance);
        data.isActive = Boolean(data.isActive);

        return data;
    }

    function disabledForm({ isEdit }) {
        if (isEdit) {
            document.getElementsByName('vendorCode')[0].disabled = true;
        }
        else {
            document.getElementsByName('vendorCode')[0].disabled = false;
        }
    }

    function setForm(data) {

        document.getElementsByName('vendorId')[0].value = data.vendorId;
        document.getElementsByName('vendorCode')[0].value = data.vendorCode;
        document.getElementsByName('balance')[0].value = data.balance;
       

        document.getElementById('form-create-create-by').innerText = data.createBy;
        document.getElementById('form-create-create-date').innerText = dateToFormat(data.createDate);
        document.getElementById('form-create-update-by').innerText = data.updateBy;
        document.getElementById('form-create-update-date').innerText = dateToFormat(data.updateDate);
    }

    let columnDefs = [
        {
            field: 'taxId',
            headerName: 'เลขที่ผู้เสียภาษี',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'vendorCode',
            headerName: 'รหัสบริษัท - คู่ค้า',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'vendorName',
            headerName: 'ชื่อบริษัท - คู่ค้า',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'contactName',
            headerName: 'ชื่อผู้ติดต่อ',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'contactTel',
            headerName: 'เบอร์โทรติดต่อ',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },
        {
            field: 'balance',
            headerName: 'เครดิตคงเหลือ',
            filter: 'agTextColumnFilter',
            minWidth: 200,
        },

        {
            field: 'action',
            headerName: '#',
            cellStyle: { textAlign: 'center' },
            minWidth: 60,
            width: 60,
            pinned: 'right',
            cellRenderer: function(params) {
                return '<div><i class="fas fa-edit" data-toggle="tooltip" data-placement="bottom" title="แก้ไข" style="color:orange; cursor: pointer;" onClick="openEditModal(' + params.data.vendorId + ')"> ';
            }
        }

    ];


</script>